<UserControl
    x:Class="MaiziWPF.Modules.Sys.LoginInfoListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:maiziWPF="clr-namespace:MaiziWPF.Core;assembly=MaiziWPF.Core"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True">

    <UserControl.Resources>
        <maiziWPF:DateTimeConverter x:Key="DateTimeConverter" />
    </UserControl.Resources>

    <Border Background="WhiteSmoke" CornerRadius="0 0 10 0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  筛选条件  -->
            <Border Grid.Row="0" Margin="12,12,12,6" Background="#ffffff" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  筛选条件标题栏  -->
                    <Grid Margin="16,12,16,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="筛选条件" Foreground="#333333" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ToggleButton x:Name="FilterToggle" Grid.Column="1" Width="24" Height="24" IsChecked="True">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <materialDesign:PackIcon Kind="ChevronUp" Foreground="#595959" Width="16" Height="16" />
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0" Padding="0">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="False">
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <materialDesign:PackIcon Kind="ChevronDown" Foreground="#595959" Width="16" Height="16" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                    </Grid>

                    <!--  筛选字段  -->
                    <Border x:Name="FilterPanel" Grid.Row="1" Padding="16,0,16,16">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=FilterToggle}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="280" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="用户名称" Foreground="#666666" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Column="1" Padding="8,6" FontSize="13" Text="{Binding QueryPageInfo.UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Column="2" Text="登录地址" Foreground="#666666" FontSize="13" VerticalAlignment="Center" Margin="16,0,8,0" />
                            <TextBox Grid.Column="3" Padding="8,6" FontSize="13" Text="{Binding QueryPageInfo.Ipaddr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Column="4" Text="登录时间" Foreground="#666666" FontSize="13" VerticalAlignment="Center" Margin="16,0,8,0" />
                            <maiziWPF:DateRangeControl Grid.Column="5" EndDateTime="{Binding QueryPageInfo.StartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" StartDateTime="{Binding QueryPageInfo.EndDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <StackPanel Grid.Column="7" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button
                                    Margin="0,0,8,0"
                                    Padding="16,6"
                                    Background="#1890ff"
                                    BorderBrush="#1890ff"
                                    Command="{Binding SearchButtonCommand}"
                                    Content="搜索"
                                    Foreground="#fff"
                                    Style="{StaticResource MaterialDesignRaisedLightButton}" />
                                <Button
                                    Padding="16,6"
                                    BorderBrush="#dcdfe6"
                                    Command="{Binding ResetButtonCommand}"
                                    Content="重置"
                                    Foreground="#606266"
                                    Style="{StaticResource MaterialDesignOutlinedDarkButton}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!--  登录日志标题栏  -->
            <Border Grid.Row="1" Margin="12,6,12,6" Background="#ffffff" CornerRadius="8">
                <Grid Margin="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="登录日志" Foreground="#333333" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="系统登录日志记录，包含用户名称、登录地址、登录地点、操作系统等信息。" Foreground="#999999" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button
                            Margin="0,0,8,0"
                            Padding="12,6"
                            Background="#cf3539"
                            BorderBrush="#cf3539"
                            Command="{Binding BatchDeleteCommand}"
                            CommandParameter="{Binding SelectedItems, ElementName=LoginInfoDataGrid}"
                            Foreground="#fff"
                            Style="{StaticResource MaterialDesignRaisedLightButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Delete" Width="14" Height="14" Margin="0,0,4,0" />
                                <TextBlock Text="删除" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button
                            Padding="12,6"
                            Background="#cf3539"
                            BorderBrush="#cf3539"
                            Command="{Binding CleanLogCommand}"
                            Foreground="#fff"
                            Style="{StaticResource MaterialDesignRaisedLightButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="DeleteSweep" Width="14" Height="14" Margin="0,0,4,0" />
                                <TextBlock Text="清空" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  表格  -->
            <Border Grid.Row="2" Margin="12,0,12,12" Background="#ffffff" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DataGrid
                        x:Name="LoginInfoDataGrid"
                        Grid.Row="0"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        GridLinesVisibility="None"
                        HeadersVisibility="Column"
                        ItemsSource="{Binding DataList}"
                        SelectionMode="Extended"
                        Background="Transparent">
                        <DataGrid.Resources>
                            <Style BasedOn="{StaticResource MaterialDesignDataGridCell}" TargetType="DataGridCell">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Padding" Value="16,0" />
                                <Setter Property="FontSize" Value="13" />
                                <Setter Property="Foreground" Value="#666666" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#fafafa" />
                                <Setter Property="Foreground" Value="#333333" />
                                <Setter Property="FontSize" Value="13" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Height" Value="40" />
                                <Setter Property="BorderBrush" Value="#e8e8e8" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="Padding" Value="16,0" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowStyle>
                            <Style BasedOn="{StaticResource MaterialDesignDataGridRow}" TargetType="DataGridRow">
                                <Setter Property="Height" Value="44" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="60" IsReadOnly="False">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <CheckBox x:Name="SelectAllCheckBox"
                                                  Click="SelectAllCheckBox_Click"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center"
                                                  PreviewMouseLeftButtonDown="RowCheckBox_PreviewMouseLeftButtonDown">
                                            <CheckBox.Style>
                                                <Style TargetType="CheckBox" BasedOn="{StaticResource MaterialDesignCheckBox}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}" Value="True">
                                                            <Setter Property="IsChecked" Value="True" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </CheckBox.Style>
                                        </CheckBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                                Binding="{Binding InfoId}"
                                Header="访问编号"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                Binding="{Binding UserName}"
                                Header="用户名称"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                Binding="{Binding ClientVersion}"
                                Header="客户端版本"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                Binding="{Binding Ipaddr}"
                                Header="登录地址"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                Binding="{Binding LoginLocation}"
                                Header="登录地点"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                Binding="{Binding MacAddress}"
                                Header="MAC地址"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                Binding="{Binding Os}"
                                Header="操作系统"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                Binding="{Binding Msg}"
                                Header="提示消息"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                Binding="{Binding LoginTime, Converter={StaticResource DateTimeConverter}, ConverterParameter='yyyy-MM-dd HH:mm:ss'}"
                                Header="登录时间"
                                IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <maiziWPF:PageControl
                        Grid.Row="1"
                        Margin="16,12"
                        HorizontalAlignment="Right"
                        Count="{Binding Count}"
                        NextCommand="{Binding NextButtonCommand}"
                        PageNumber="{Binding PageNumber}"
                        PageSize="{Binding PageSize}"
                        PrevCommand="{Binding PrevButtonCommand}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>