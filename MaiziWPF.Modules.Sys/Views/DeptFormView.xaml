<UserControl
    x:Class="MaiziWPF.Modules.Sys.DeptFormView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:MaiziWPF.Core;assembly=MaiziWPF.Core"
    xmlns:domain="clr-namespace:MaiziWPF.Services.Domain;assembly=MaiziWPF.Services.Domain"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True">

    <UserControl.Resources>
        <core:EditModeVisibilityConverter x:Key="EditModeVisibilityConverter" />

        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#606266" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="FormTextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}" TargetType="TextBox">
            <Setter Property="materialDesign:HintAssist.IsFloating" Value="False" />
            <Setter Property="materialDesign:TextFieldAssist.HasClearButton" Value="True" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="FormComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}" TargetType="ComboBox">
            <Setter Property="materialDesign:HintAssist.IsFloating" Value="False" />
            <Setter Property="materialDesign:TextFieldAssist.HasClearButton" Value="False" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </UserControl.Resources>

    <Grid Width="480" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="60" />
            <RowDefinition Height="60" />
            <RowDefinition Height="60" />
            <RowDefinition Height="60" />
            <RowDefinition Height="60" />
            <RowDefinition Height="60" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FormLabel}" Text="上级部门" />
        <materialDesign:Card
            Grid.Row="0"
            Grid.Column="1"
            Height="36"
            Margin="0,0,0,12"
            Style="{StaticResource FormCardStyle}">
            <ComboBox
                Style="{StaticResource FormComboBox}"
                materialDesign:HintAssist.Hint="请选择上级部门"
                ItemsSource="{Binding DeptTreeItems}"
                SelectedValue="{Binding ParentId}"
                SelectedValuePath="Id">
                <ComboBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type domain:SysDept}">
                        <TextBlock Text="{Binding DeptName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </materialDesign:Card>

        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FormLabel}" Text="部门名称" />
        <TextBox
            Grid.Row="1"
            Grid.Column="1"
            Margin="0,0,0,12"
            Style="{StaticResource FormTextBox}"
            Text="{Binding DeptName, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FormLabel}" Text="显示排序" />
        <TextBox
            Grid.Row="2"
            Grid.Column="1"
            Margin="0,0,0,12"
            Style="{StaticResource FormTextBox}"
            Text="{Binding OrderNum, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FormLabel}" Text="负责人" />
        <TextBox
            Grid.Row="3"
            Grid.Column="1"
            Margin="0,0,0,12"
            Style="{StaticResource FormTextBox}"
            Text="{Binding Leader, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource FormLabel}" Text="联系电话" />
        <TextBox
            Grid.Row="4"
            Grid.Column="1"
            Margin="0,0,0,12"
            Style="{StaticResource FormTextBox}"
            Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource FormLabel}" Text="邮箱" />
        <TextBox
            Grid.Row="5"
            Grid.Column="1"
            Margin="0,0,0,12"
            Style="{StaticResource FormTextBox}"
            Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource FormLabel}" Text="状态" />
        <ComboBox
            Grid.Row="6"
            Grid.Column="1"
            Height="36"
            Margin="0,0,0,12"
            Style="{StaticResource FormComboBox}"
            SelectedValue="{Binding Status}"
            SelectedValuePath="DictValue">
            <ComboBox.Items>
                <domain:SysDictData DictLabel="正常" DictValue="0" />
                <domain:SysDictData DictLabel="停用" DictValue="1" />
            </ComboBox.Items>
            <ComboBox.ItemTemplate>
                <DataTemplate DataType="{x:Type domain:SysDictData}">
                    <TextBlock Text="{Binding DictLabel}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <StackPanel
            Grid.Row="7"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
            <Button
                Width="100"
                Margin="0,12,12,0"
                Background="#1890ff"
                BorderBrush="#1890ff"
                Command="{Binding AcceptCommand}"
                Content="确定"
                Foreground="#fff"
                Style="{StaticResource MaterialDesignRaisedLightButton}" />
            <Button
                Width="100"
                Margin="0,12,0,0"
                BorderBrush="#dcdfe6"
                Command="{Binding CancelCommand}"
                Content="取消"
                Foreground="#606266"
                Style="{StaticResource MaterialDesignOutlinedDarkButton}" />
        </StackPanel>
    </Grid>
</UserControl>