<UserControl
    x:Class="MaiziWPF.Modules.Sys.DeptFormView"
    x:Name="RootUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:MaiziWPF.Core;assembly=MaiziWPF.Core"
    xmlns:domain="clr-namespace:MaiziWPF.Services.Domain;assembly=MaiziWPF.Services.Domain"
    xmlns:maiziWPF="clr-namespace:MaiziWPF.Core;assembly=MaiziWPF.Core"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Width="540" Height="320">
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="Title" Value="{Binding DialogTitle}" />
        </Style>
    </prism:Dialog.WindowStyle>
    <UserControl.Resources>
        <maiziWPF:BooleanConverter x:Key="EqualToBooleanConverter" />
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#606266" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <Style x:Key="RadioStyle" TargetType="RadioButton">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#606266" />
            <Setter Property="Margin" Value="0,0,24,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="1" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,12,20,12">
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource FormLabel}" Text="上级部门" />
                    <controls:DeptTreeSelectControl
                        Grid.Column="2"
                        SelectedDeptId="{Binding ParentId, Mode=TwoWay}"/>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource FormLabel}" Foreground="#ff4d4f" Text="* 部门名称" />
                    <TextBox
                        Grid.Column="2"
                        Height="36"
                        FontSize="13"
                        Text="{Binding DeptName, UpdateSourceTrigger=PropertyChanged}"
                        materialDesign:HintAssist.Hint="请输入部门名称" />
                    <TextBlock Grid.Column="3" Style="{StaticResource FormLabel}" Text="显示排序" />
                    <TextBox
                        Grid.Column="5"
                        Height="36"
                        Width="120"
                        HorizontalAlignment="Left"
                        FontSize="13"
                        Text="{Binding OrderNum, UpdateSourceTrigger=PropertyChanged}"
                        materialDesign:HintAssist.Hint="请输入排序号" />
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource FormLabel}" Text="类别编码" />
                    <TextBox
                        Grid.Column="2"
                        Height="36"
                        FontSize="13"
                        Text="{Binding DeptCategory, UpdateSourceTrigger=PropertyChanged}"
                        materialDesign:HintAssist.Hint="请输入部门类别编码" />
                    <TextBlock Grid.Column="3" Style="{StaticResource FormLabel}" Text="负责人" />
                    <controls:UserSelectControl
                        Grid.Column="5"
                        SelectedUserId="{Binding Leader, Mode=TwoWay}"
                        Placeholder="请选择负责人" />
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource FormLabel}" Text="联系电话" />
                    <TextBox
                        Grid.Column="2"
                        Height="36"
                        FontSize="13"
                        Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                        materialDesign:HintAssist.Hint="请输入联系电话" />
                    <TextBlock Grid.Column="3" Style="{StaticResource FormLabel}" Text="邮箱" />
                    <TextBox
                        Grid.Column="5"
                        Height="36"
                        FontSize="13"
                        Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                        materialDesign:HintAssist.Hint="请输入邮箱" />
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource FormLabel}" Text="部门状态" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton
                            Content="正常"
                            GroupName="Status"
                            IsChecked="{Binding Status, Converter={StaticResource EqualToBooleanConverter}, ConverterParameter=0}"
                            Style="{StaticResource RadioStyle}" />
                        <RadioButton
                            Content="停用"
                            GroupName="Status"
                            IsChecked="{Binding Status, Converter={StaticResource EqualToBooleanConverter}, ConverterParameter=1}"
                            Style="{StaticResource RadioStyle}" />
                    </StackPanel>
                </Grid>
            </StackPanel>

        <Border Grid.Row="1" Background="#f0f0f0" />

        <StackPanel
            Grid.Row="2"
            Margin="20,12,20,16"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Margin="0,0,12,0"
                Padding="24,8"
                Background="#1890ff"
                BorderBrush="#1890ff"
                Command="{Binding AcceptCommand}"
                Content="确定"
                Foreground="#fff"
                Style="{StaticResource MaterialDesignRaisedLightButton}" />
            <Button
                Padding="24,8"
                BorderBrush="#dcdfe6"
                Command="{Binding CancelCommand}"
                Content="取消"
                Foreground="#606266"
                Style="{StaticResource MaterialDesignOutlinedDarkButton}" />
        </StackPanel>
    </Grid>
</UserControl>