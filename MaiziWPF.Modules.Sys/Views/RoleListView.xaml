<UserControl
    x:Class="MaiziWPF.Modules.Sys.RoleListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:domain="clr-namespace:MaiziWPF.Services.Domain;assembly=MaiziWPF.Services.Domain"
    xmlns:maiziWPF="clr-namespace:MaiziWPF.Core;assembly=MaiziWPF.Core"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <maiziWPF:DateTimeConverter x:Key="DateTimeConverter" />
        <maiziWPF:BooleanConverter x:Key="BooleanConverter" />
    </UserControl.Resources>
    <Border Background="WhiteSmoke" CornerRadius="0 0 10 0">
        <Grid Margin="10,6,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!--  条件  -->
            <WrapPanel>
                <materialDesign:Card Width="200" Style="{StaticResource FormCardStyle}">
                    <TextBox
                        materialDesign:HintAssist.Hint="请输入角色名称"
                        materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                        materialDesign:TextFieldAssist.HasClearButton="True"
                        BorderThickness="0"
                        FontSize="16"
                        Text="{Binding QueryPageInfo.RoleName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </materialDesign:Card>
                <materialDesign:Card Width="200" Style="{StaticResource FormCardStyle}">
                    <TextBox
                        materialDesign:HintAssist.Hint="请输入权限字符"
                        materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                        materialDesign:TextFieldAssist.HasClearButton="True"
                        BorderThickness="0"
                        FontSize="16"
                        Text="{Binding QueryPageInfo.RoleKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </materialDesign:Card>
                <materialDesign:Card Width="200" Style="{StaticResource FormCardStyle}">
                    <ComboBox
                        maiziWPF:DataDictAssist.Type="sys_normal_disable"
                        materialDesign:HintAssist.Hint="角色状态"
                        materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                        materialDesign:TextFieldAssist.HasClearButton="True"
                        BorderThickness="0"
                        FontSize="16"
                        SelectedItem="{Binding QueryPageInfo.Status, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type domain:SysDictData}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DictLabel}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </materialDesign:Card>
                <materialDesign:Card Width="280" Style="{StaticResource FormCardStyle}">
                    <maiziWPF:DateRangeControl EndDateTime="{Binding QueryPageInfo.StartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" StartDateTime="{Binding QueryPageInfo.EndDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </materialDesign:Card>
                <StackPanel Margin="6,0,0,6" Orientation="Horizontal">
                    <Button
                        Margin="0,0,8,0"
                        Background="#1890ff"
                        BorderBrush="#1890ff"
                        Command="{Binding SearchButtonCommand}"
                        Content="搜索"
                        Foreground="#fff"
                        Style="{StaticResource MaterialDesignRaisedLightButton}" />
                    <Button
                        BorderBrush="#dcdfe6"
                        Content="重置"
                        Foreground="#606266"
                        Style="{StaticResource MaterialDesignOutlinedDarkButton}" />
                </StackPanel>
            </WrapPanel>
            <StackPanel Grid.Row="1" Margin="0,6,10,6" Orientation="Horizontal">
                <Button
                    Padding="8,4"
                    Background="#1890ff"
                    BorderBrush="#1890ff"
                    Command="{Binding AddRoleCommand}"
                    Content="新增"
                    Foreground="#fff"
                    Style="{StaticResource MaterialDesignRaisedLightButton}" />
            </StackPanel>
            <!--  表格  -->
            <DataGrid
                Grid.Row="2"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                GridLinesVisibility="None"
                ItemsSource="{Binding DataList}">
                <DataGrid.CellStyle>
                    <Style BasedOn="{StaticResource MaterialDesignDataGridCell}" TargetType="DataGridCell">
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="BorderThickness" Value="0" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Binding="{Binding RoleId}"
                        Header="角色编号"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Binding="{Binding RoleName}"
                        Header="角色名称"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Binding="{Binding RoleKey}"
                        Header="权限字符"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Binding="{Binding RoleSort}"
                        Header="显示顺序"
                        IsReadOnly="True" />
                    <DataGridTemplateColumn Header="状态">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ToggleButton IsChecked="{Binding Status, Converter={StaticResource BooleanConverter}, ConverterParameter='1'}" Style="{StaticResource MaterialDesignSwitchToggleButton}">
                                    <materialDesign:ToggleButtonAssist.SwitchTrackOnBackground>
                                        <SolidColorBrush Color="#cf3539" />
                                    </materialDesign:ToggleButtonAssist.SwitchTrackOnBackground>
                                </ToggleButton>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn
                        Binding="{Binding CreateTime, Converter={StaticResource DateTimeConverter}}"
                        Header="创建时间"
                        IsReadOnly="True" />
                    <DataGridTemplateColumn Header="操作">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button
                                        Padding="5"
                                        Content="修改"
                                        Foreground="#1890ff"
                                        Style="{StaticResource MaterialDesignFlatLightButton}"
                                        Command="{Binding DataContext.NewOrEditButtonCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                        CommandParameter="{Binding}" />
                                    <Button
                                        Padding="5"
                                        Content="删除"
                                        Foreground="#cf3539"
                                        Style="{StaticResource MaterialDesignFlatLightButton}"
                                        Command="{Binding DataContext.DeleteButtonCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                        CommandParameter="{Binding}" />
                                    <Menu materialDesign:MenuAssist.MenuItemsPresenterMargin="3" materialDesign:MenuAssist.TopLevelMenuItemHeight="30">
                                        <MenuItem Padding="5" Header="更多&gt;&gt;">
                                            <MenuItem Header="数据权限" />
                                            <MenuItem Header="分配用户" />
                                        </MenuItem>
                                    </Menu>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <maiziWPF:PageControl
                Grid.Row="3"
                Margin="0,0,10,10"
                HorizontalAlignment="Right"
                Count="{Binding Count}"
                IsBusy="{Binding IsBusy}"
                NextCommand="{Binding NextButtonCommand}"
                PageNumber="{Binding PageNumber}"
                PageSize="{Binding PageSize}"
                PageSizeChangedCommand="{Binding PageSizeChangedCommand}"
                PrevCommand="{Binding PrevButtonCommand}" />
        </Grid>
    </Border>
</UserControl>