<UserControl
    x:Class="MaiziWPF.Modules.Sys.RolePermissionView"
    x:Name="RootUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Width="820" Height="600">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="Title" Value="{Binding DialogTitle}" />
        </Style>
    </prism:Dialog.WindowStyle>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="1" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="16,12" Background="#fafafa" BorderBrush="#e8e8e8" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock FontSize="12" Foreground="#999">
                    <Run Text="角色：" /><Run Text="{Binding RoleName}" FontWeight="SemiBold" Foreground="#333" />
                    <Run Text="  |  权限字符：" /><Run Text="{Binding RoleKey}" Foreground="#666" />
                </TextBlock>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#ffffff" Margin="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Margin="12,12,12,8"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="#333"
                        Text="菜单权限" />

                    <StackPanel Grid.Row="1" Margin="12,0,12,8" Orientation="Horizontal">
                        <CheckBox
                            x:Name="MenuCheckStrictlyCheck"
                            Content="父子联动"
                            FontSize="12"
                            Foreground="#606266"
                            IsChecked="{Binding MenuCheckStrictly}"
                            VerticalAlignment="Center" />
                    </StackPanel>

                    <TreeView
                        Grid.Row="2"
                        Margin="8,0,8,8"
                        BorderThickness="0"
                        ItemsSource="{Binding MenuTreeItems}">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="True" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <CheckBox
                                    Margin="0,2"
                                    Content="{Binding Name}"
                                    FontSize="13"
                                    Foreground="#333"
                                    IsChecked="{Binding IsChecked}"
                                    IsEnabled="{Binding IsEnabled}" />
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <GridSplitter
                Grid.Column="1"
                Width="2"
                Background="#e8e8e8"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch" />

            <Border Grid.Column="2" Background="#ffffff" Margin="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Margin="12,12,12,8"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="#333"
                        Text="数据权限" />

                    <StackPanel Grid.Row="1" Margin="12,0,12,8">
                        <TextBlock
                            Margin="0,0,0,4"
                            FontSize="12"
                            Foreground="#606266"
                            Text="权限范围" />
                        <ComboBox
                            Height="34"
                            FontSize="13"
                            ItemsSource="{Binding DataScopeOptions}"
                            SelectedValuePath="Value"
                            SelectedValue="{Binding DataScope}"
                            DisplayMemberPath="Label" />

                        <CheckBox
                            x:Name="DeptCheckStrictlyCheck"
                            Margin="0,12,0,8"
                            Content="父子联动"
                            FontSize="12"
                            Foreground="#606266"
                            IsChecked="{Binding DeptCheckStrictly}" />

                        <TreeView
                            Grid.Row="2"
                            MaxHeight="280"
                            Margin="0,4,0,0"
                            BorderThickness="0"
                            ItemsSource="{Binding DeptTreeItems}"
                            Visibility="{Binding IsCustomDataScope, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="True" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <CheckBox
                                        Margin="0,2"
                                        Content="{Binding DeptName}"
                                        FontSize="13"
                                        Foreground="#333"
                                        IsChecked="{Binding IsChecked}" />
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#f0f0f0" />

        <StackPanel
            Grid.Row="3"
            Margin="20,12,20,16"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Margin="0,0,12,0"
                Padding="24,8"
                Background="#1890ff"
                BorderBrush="#1890ff"
                Command="{Binding AcceptCommand}"
                Content="确定"
                Foreground="#fff"
                Style="{StaticResource MaterialDesignRaisedLightButton}" />
            <Button
                Padding="24,8"
                Command="{Binding CancelCommand}"
                Content="取消"
                Foreground="#333333"
                Style="{StaticResource MaterialDesignOutlinedDarkButton}" />
        </StackPanel>
    </Grid>
</UserControl>