<UserControl
    x:Class="MaiziWPF.Modules.Sys.NoticeListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:domain="clr-namespace:MaiziWPF.Services.Domain;assembly=MaiziWPF.Services.Domain"
    xmlns:maiziWPF="clr-namespace:MaiziWPF.Core;assembly=MaiziWPF.Core"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True">

    <Border Background="WhiteSmoke" CornerRadius="0 0 10 0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  筛选条件  -->
            <Border Grid.Row="0" Margin="12,12,12,6" Background="#ffffff" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="16,12,16,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="筛选条件" Foreground="#333333" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ToggleButton x:Name="FilterToggle" Grid.Column="1" Width="24" Height="24" IsChecked="True">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <materialDesign:PackIcon Kind="ChevronUp" Foreground="#595959" Width="16" Height="16" />
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0" Padding="0">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="False">
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <materialDesign:PackIcon Kind="ChevronDown" Foreground="#595959" Width="16" Height="16" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                    </Grid>

                    <Border x:Name="FilterPanel" Grid.Row="1" Padding="16,0,16,16">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=FilterToggle}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,16,0">
                                <TextBlock Width="72" Text="公告标题" TextAlignment="Right" Foreground="#666666" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Width="200" Height="36" Padding="8,6" FontSize="13" Text="{Binding QueryPageInfo.NoticeTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,8,16,0">
                                <TextBlock Width="72" Text="操作人员" TextAlignment="Right" Foreground="#666666" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Width="200" Height="36" Padding="8,6" FontSize="13" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,8,16,0">
                                <TextBlock Width="72" Text="类型" TextAlignment="Right" Foreground="#666666" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox
                                    Width="120"
                                    Height="36"
                                    Padding="8,6"
                                    FontSize="13"
                                    maiziWPF:DataDictAssist.Type="sys_notice_type"
                                    SelectedValuePath="DictValue"
                                    SelectedValue="{Binding QueryPageInfo.NoticeType, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type domain:SysDictData}">
                                            <TextBlock Text="{Binding DictLabel}" FontSize="13" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button
                                    Margin="0,0,8,0"
                                    Padding="16,6"
                                    Background="#07bf96"
                                    BorderBrush="#07bf96"
                                    Command="{Binding SearchButtonCommand}"
                                    Content="搜索"
                                    Foreground="#fff"
                                    maiziWPF:PermsAssist.Perms="system:notice:query"
                                    Style="{StaticResource MaterialDesignRaisedLightButton}" />
                                <Button
                                    Padding="16,6"
                                    BorderBrush="#dcdfe6"
                                    Command="{Binding ResetButtonCommand}"
                                    Content="重置"
                                    Foreground="#606266"
                                    maiziWPF:PermsAssist.Perms="system:notice:query"
                                    Style="{StaticResource MaterialDesignOutlinedDarkButton}" />
                            </StackPanel>
                        </WrapPanel>
                    </Border>
                </Grid>
            </Border>

            <!--  公告列表标题栏  -->
            <Border Grid.Row="1" Margin="12,6,12,6" Background="#ffffff" CornerRadius="8">
                <Grid Margin="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="公告列表" Foreground="#333333" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="通知公告管理，支持类型筛选、内容编辑和状态管理。" Foreground="#999999" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button
                            Margin="0,0,8,0"
                            Padding="12,6"
                            Background="#07bf96"
                            BorderBrush="#07bf96"
                            Command="{Binding AddButtonCommand}"
                            Foreground="#fff"
                            maiziWPF:PermsAssist.Perms="system:notice:add"
                            Style="{StaticResource MaterialDesignRaisedLightButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" Margin="0,0,4,0" />
                                <TextBlock Text="新增" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button
                            Padding="12,6"
                            Background="#ff4d4f"
                            BorderBrush="#ff4d4f"
                            Command="{Binding BatchDeleteCommand}"
                            CommandParameter="{Binding SelectedItems, ElementName=NoticeDataGrid}"
                            Foreground="#fff"
                            maiziWPF:PermsAssist.Perms="system:notice:remove"
                            Style="{StaticResource MaterialDesignRaisedLightButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Delete" Width="14" Height="14" Margin="0,0,4,0" />
                                <TextBlock Text="删除" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  表格  -->
            <Border Grid.Row="2">
                <DataGrid
                    x:Name="NoticeDataGrid"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    GridLinesVisibility="None"
                    SelectionMode="Extended"
                    ItemsSource="{Binding DataList}">
                    <DataGrid.Resources>
                        <Style x:Key="NoticeTypeBadgeStyle" TargetType="Border">
                            <Setter Property="CornerRadius" Value="10" />
                            <Setter Property="Padding" Value="10,2" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Background" Value="#f6ffed" />
                            <Setter Property="BorderBrush" Value="#b7eb8f" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NoticeType}" Value="2">
                                    <Setter Property="Background" Value="#fff7e6" />
                                    <Setter Property="BorderBrush" Value="#ffd591" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                        <Style x:Key="StatusBadgeStyle" TargetType="Border">
                            <Setter Property="CornerRadius" Value="10" />
                            <Setter Property="Padding" Value="10,2" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Background" Value="#e6f7ff" />
                            <Setter Property="BorderBrush" Value="#91d5ff" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="1">
                                    <Setter Property="Background" Value="#fff1f0" />
                                    <Setter Property="BorderBrush" Value="#ffa39e" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#fafafa" />
                            <Setter Property="Foreground" Value="#333333" />
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Height" Value="40" />
                            <Setter Property="BorderBrush" Value="#e8e8e8" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="Padding" Value="16,0" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style BasedOn="{StaticResource MaterialDesignDataGridCell}" TargetType="DataGridCell">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="BorderThickness" Value="0" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="60" IsReadOnly="False">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <CheckBox x:Name="SelectAllCheckBox"
                                              Click="SelectAllCheckBox_Click"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center"
                                              PreviewMouseLeftButtonDown="RowCheckBox_PreviewMouseLeftButtonDown">
                                        <CheckBox.Style>
                                            <Style TargetType="CheckBox" BasedOn="{StaticResource MaterialDesignCheckBox}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}" Value="True">
                                                        <Setter Property="IsChecked" Value="True" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </CheckBox.Style>
                                    </CheckBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Width="*" Binding="{Binding NoticeTitle}" Header="公告标题" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Width="*" Header="公告类型">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource NoticeTypeBadgeStyle}" HorizontalAlignment="Center">
                                        <TextBlock FontSize="11" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#52c41a" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding NoticeType}" Value="1">
                                                            <Setter Property="Text" Value="通知" />
                                                            <Setter Property="Foreground" Value="#fa8c16" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding NoticeType}" Value="2">
                                                            <Setter Property="Text" Value="公告" />
                                                            <Setter Property="Foreground" Value="#52c41a" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="*" Header="状态">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StatusBadgeStyle}" HorizontalAlignment="Center">
                                        <TextBlock FontSize="11" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#52c41a" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="0">
                                                            <Setter Property="Text" Value="正常" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="1">
                                                            <Setter Property="Text" Value="关闭" />
                                                            <Setter Property="Foreground" Value="#ff4d4f" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Width="*" Binding="{Binding CreateBy}" Header="创建者" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Width="*" Binding="{Binding CreateTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Header="创建时间" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Width="*" Header="操作">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Button
                                            Width="26"
                                            Height="24"
                                            Margin="0,0,4,0"
                                            Background="#e6f7ff"
                                            BorderBrush="#91d5ff"
                                            BorderThickness="1"
                                            Command="{Binding DataContext.ViewButtonCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}"
                                            maiziWPF:PermsAssist.Perms="system:notice:query"
                                            ToolTip="查看">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="3">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <materialDesign:PackIcon Kind="Eye" Foreground="#91d5ff" Width="14" Height="14" />
                                        </Button>
                                        <Button
                                            Width="26"
                                            Height="24"
                                            Margin="0,0,4,0"
                                            Background="#fff7e6"
                                            BorderBrush="#ffd591"
                                            BorderThickness="1"
                                            Command="{Binding DataContext.EditButtonCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}"
                                            maiziWPF:PermsAssist.Perms="system:notice:edit"
                                            ToolTip="修改">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="3">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <materialDesign:PackIcon Kind="Pencil" Foreground="#ffd591" Width="14" Height="14" />
                                        </Button>
                                        <Button
                                            Width="26"
                                            Height="24"
                                            Background="#fff1f0"
                                            BorderBrush="#ffa39e"
                                            BorderThickness="1"
                                            Command="{Binding DataContext.DeleteButtonCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}"
                                            maiziWPF:PermsAssist.Perms="system:notice:remove"
                                            ToolTip="删除">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="3">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <materialDesign:PackIcon Kind="Delete" Foreground="#ffa39e" Width="14" Height="14" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <maiziWPF:PageControl
                Grid.Row="3"
                Margin="0,8,12,12"
                HorizontalAlignment="Right"
                Count="{Binding Count}"
                IsBusy="{Binding IsBusy}"
                NextCommand="{Binding NextButtonCommand}"
                PageNumber="{Binding PageNumber}"
                PageSize="{Binding PageSize}"
                PageSizeChangedCommand="{Binding PageSizeChangedCommand}"
                PrevCommand="{Binding PrevButtonCommand}" />
        </Grid>
    </Border>
</UserControl>