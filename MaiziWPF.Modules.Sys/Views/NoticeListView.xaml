<UserControl
    x:Class="MaiziWPF.Modules.Sys.NoticeListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:domain="clr-namespace:MaiziWPF.Services.Domain;assembly=MaiziWPF.Services.Domain"
    xmlns:maiziWPF="clr-namespace:MaiziWPF.Core;assembly=MaiziWPF.Core"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <maiziWPF:DateTimeConverter x:Key="DateTimeConverter" />
    </UserControl.Resources>
    <Border Background="WhiteSmoke" CornerRadius="0 0 10 0">
        <Grid Margin="10,6,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!--  条件  -->
            <WrapPanel>
                <materialDesign:Card Width="200" Style="{StaticResource FormCardStyle}">
                    <TextBox
                        materialDesign:HintAssist.Hint="公告标题"
                        materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                        materialDesign:TextFieldAssist.HasClearButton="True"
                        BorderThickness="0"
                        FontSize="16"
                        Text="{Binding QueryPageInfo.NoticeTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </materialDesign:Card>
                <materialDesign:Card Width="280" Style="{StaticResource FormCardStyle}">
                    <maiziWPF:DateRangeControl EndDateTime="{Binding QueryPageInfo.StartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" StartDateTime="{Binding QueryPageInfo.EndDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </materialDesign:Card>
                <StackPanel Margin="6,0,0,6" Orientation="Horizontal">
                    <Button
                        Margin="0,0,8,0"
                        Background="#1890ff"
                        BorderBrush="#1890ff"
                        Command="{Binding SearchButtonCommand}"
                        Content="搜索"
                        Foreground="#fff"
                        Style="{StaticResource MaterialDesignRaisedLightButton}" />
                    <Button
                        BorderBrush="#dcdfe6"
                        Content="重置"
                        Foreground="#606266"
                        Style="{StaticResource MaterialDesignOutlinedDarkButton}" />
                </StackPanel>
            </WrapPanel>
            <!--  工具栏  -->
            <StackPanel
                Grid.Row="1"
                Margin="0,6,0,6"
                Orientation="Horizontal">
                <Button
                    Margin="0,0,8,0"
                    Background="#1890ff"
                    BorderBrush="#1890ff"
                    Command="{Binding AddNoticeCommand}"
                    Content="新增"
                    Foreground="#fff"
                    Style="{StaticResource MaterialDesignRaisedLightButton}" />
            </StackPanel>
            <!--  表格  -->
            <DataGrid
                Grid.Row="1"
                Margin="0,32,0,0"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                GridLinesVisibility="None"
                ItemsSource="{Binding DataList}">
                <DataGrid.CellStyle>
                    <Style BasedOn="{StaticResource MaterialDesignDataGridCell}" TargetType="DataGridCell">
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="BorderThickness" Value="0" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Binding="{Binding NoticeId}"
                        Header="公告编号"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Binding="{Binding NoticeTitle}"
                        Header="公告标题"
                        IsReadOnly="True" />
                    <DataGridTemplateColumn Header="公告类型">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type domain:SysNotice}">
                                <Label x:Name="typeLabel" HorizontalAlignment="Center" />
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding NoticeType}" Value="1">
                                        <Setter TargetName="typeLabel" Property="Content" Value="通知" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding NoticeType}" Value="2">
                                        <Setter TargetName="typeLabel" Property="Content" Value="公告" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="状态">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type domain:SysNotice}">
                                <Label x:Name="statusLabel" HorizontalAlignment="Center" />
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="0">
                                        <Setter TargetName="statusLabel" Property="Content" Value="正常" />
                                        <Setter TargetName="statusLabel" Property="Foreground" Value="#1890ff" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="1">
                                        <Setter TargetName="statusLabel" Property="Content" Value="停用" />
                                        <Setter TargetName="statusLabel" Property="Foreground" Value="#999999" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn
                        Binding="{Binding CreateTime, Converter={StaticResource DateTimeConverter}, ConverterParameter='yyyy-MM-dd HH:mm:ss'}"
                        Header="创建时间"
                        IsReadOnly="True" />
                    <DataGridTemplateColumn Header="操作">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button
                                        Padding="5"
                                        Command="{Binding DataContext.NewOrEditButtonCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Content="修改"
                                        Foreground="#1890ff"
                                        Style="{StaticResource MaterialDesignFlatLightButton}" />
                                    <Button
                                        Padding="5"
                                        Command="{Binding DataContext.DeleteButtonCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Content="删除"
                                        Foreground="#cf3539"
                                        Style="{StaticResource MaterialDesignFlatLightButton}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <maiziWPF:PageControl
                Grid.Row="2"
                Margin="0,0,10,10"
                HorizontalAlignment="Right"
                Count="{Binding Count}"
                NextCommand="{Binding NextButtonCommand}"
                PageNumber="{Binding PageNumber}"
                PageSize="{Binding PageSize}"
                PrevCommand="{Binding PrevButtonCommand}" />
        </Grid>
    </Border>
</UserControl>