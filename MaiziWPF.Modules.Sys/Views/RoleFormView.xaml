<UserControl
    x:Class="MaiziWPF.Modules.Sys.RoleFormView"
    x:Name="RootUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:maiziWPF="clr-namespace:MaiziWPF.Core;assembly=MaiziWPF.Core"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Width="580" Height="620">
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="Title" Value="{Binding DialogTitle}" />
        </Style>
    </prism:Dialog.WindowStyle>
    <UserControl.Resources>
        <maiziWPF:BooleanConverter x:Key="EqualToBooleanConverter" />
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#606266" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <Style x:Key="RadioStyle" TargetType="RadioButton">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#606266" />
            <Setter Property="Margin" Value="0,0,24,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="1" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" Margin="20,12,20,12" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource FormLabel}" Foreground="#ff4d4f" Text="* 角色名称" />
                    <TextBox
                        Grid.Column="2"
                        Height="36"
                        FontSize="13"
                        Text="{Binding RoleName}"
                        materialDesign:HintAssist.Hint="请输入角色名称" />
                    <TextBlock Grid.Column="3" Style="{StaticResource FormLabel}" Text="显示排序" />
                    <TextBox
                        Grid.Column="5"
                        Height="36"
                        Width="120"
                        HorizontalAlignment="Left"
                        FontSize="13"
                        Text="{Binding RoleSort}"
                        materialDesign:HintAssist.Hint="请输入排序号" />
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource FormLabel}" Foreground="#ff4d4f" Text="* 权限字符" />
                    <TextBox
                        Grid.Column="2"
                        Height="36"
                        FontSize="13"
                        Text="{Binding RoleKey}"
                        materialDesign:HintAssist.Hint="请输入权限字符" />
                    <TextBlock Grid.Column="3" Style="{StaticResource FormLabel}" Text="角色状态" />
                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton
                            Content="正常"
                            GroupName="Status"
                            IsChecked="{Binding Status, Converter={StaticResource EqualToBooleanConverter}, ConverterParameter=0}"
                            Style="{StaticResource RadioStyle}" />
                        <RadioButton
                            Content="停用"
                            GroupName="Status"
                            IsChecked="{Binding Status, Converter={StaticResource EqualToBooleanConverter}, ConverterParameter=1}"
                            Style="{StaticResource RadioStyle}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource FormLabel}" Text="数据范围" />
                    <ComboBox
                        Grid.Column="2"
                        Height="36"
                        FontSize="13"
                        ItemsSource="{Binding DataScopeItems}"
                        SelectedValuePath="Value"
                        SelectedValue="{Binding DataScope}"
                        DisplayMemberPath="Label"
                        materialDesign:HintAssist.Hint="请选择数据范围" />
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource FormLabel}" Text="备注" />
                    <TextBox
                        Grid.Column="2"
                        Height="36"
                        FontSize="13"
                        Text="{Binding Remark}"
                        materialDesign:HintAssist.Hint="请输入备注" />
                </Grid>

                <Border
                    Margin="0,4,0,0"
                    Padding="12,10"
                    Background="#fafafa"
                    CornerRadius="6">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,6"
                            FontSize="12"
                            Foreground="#909399"
                            Text="树选择联动设置（在「分配权限」弹窗中生效）" />
                        <CheckBox
                            Margin="0,2"
                            Content="菜单父子联动（勾选父节点时自动选中所有子节点）"
                            FontSize="12"
                            Foreground="#606266"
                            IsChecked="{Binding MenuCheckStrictly}" />
                        <CheckBox
                            Margin="0,2"
                            Content="部门父子联动（勾选父节点时自动选中所有子节点）"
                            FontSize="12"
                            Foreground="#606266"
                            IsChecked="{Binding DeptCheckStrictly}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="#f0f0f0" />

        <StackPanel
            Grid.Row="2"
            Margin="20,12,20,16"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Margin="0,0,12,0"
                Padding="24,8"
                Background="#1890ff"
                BorderBrush="#1890ff"
                Command="{Binding AcceptCommand}"
                Content="确定"
                Foreground="#fff"
                Style="{StaticResource MaterialDesignRaisedLightButton}" />
            <Button
                Padding="24,8"
                Command="{Binding CancelCommand}"
                Content="取消"
                Foreground="#333333"
                Style="{StaticResource MaterialDesignOutlinedDarkButton}" />
        </StackPanel>
    </Grid>
</UserControl>