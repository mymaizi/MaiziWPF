<UserControl
    x:Class="MaiziWPF.Modules.Sys.RoleFormView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Width="500" Height="440">
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="SizeToContent" Value="WidthAndHeight" />
            <Setter Property="ResizeMode" Value="CanResizeWithGrip" />
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
        </Style>
    </prism:Dialog.WindowStyle>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            Margin="0,8,0,0"
            VerticalAlignment="Center"
            Text="角色名称"
            FontSize="14" />
        <TextBox
            Grid.Row="0"
            Grid.Column="1"
            Height="40"
            Margin="0,4"
            Text="{Binding RoleName}"
            FontSize="14"
            materialDesign:HintAssist.Hint="请输入角色名称" />

        <TextBlock
            Grid.Row="1"
            Grid.Column="0"
            Margin="0,8,0,0"
            VerticalAlignment="Center"
            Text="权限字符"
            FontSize="14" />
        <TextBox
            Grid.Row="1"
            Grid.Column="1"
            Height="40"
            Margin="0,4"
            Text="{Binding RoleKey}"
            FontSize="14"
            materialDesign:HintAssist.Hint="请输入权限字符" />

        <TextBlock
            Grid.Row="2"
            Grid.Column="0"
            Margin="0,8,0,0"
            VerticalAlignment="Center"
            Text="显示顺序"
            FontSize="14" />
        <TextBox
            Grid.Row="2"
            Grid.Column="1"
            Height="40"
            Margin="0,4"
            Text="{Binding RoleSort}"
            FontSize="14"
            materialDesign:HintAssist.Hint="请输入排序号" />

        <TextBlock
            Grid.Row="3"
            Grid.Column="0"
            Margin="0,8,0,0"
            VerticalAlignment="Center"
            Text="数据范围"
            FontSize="14" />
        <ComboBox
            Grid.Row="3"
            Grid.Column="1"
            Height="40"
            Margin="0,4"
            SelectedItem="{Binding DataScope}"
            FontSize="14">
            <ComboBoxItem Content="全部数据权限" Tag="1" />
            <ComboBoxItem Content="自定义数据权限" Tag="2" />
            <ComboBoxItem Content="本部门数据权限" Tag="3" />
            <ComboBoxItem Content="本部门及以下数据权限" Tag="4" />
            <ComboBoxItem Content="仅本人数据权限" Tag="5" />
        </ComboBox>

        <TextBlock
            Grid.Row="4"
            Grid.Column="0"
            Margin="0,8,0,0"
            VerticalAlignment="Center"
            Text="角色状态"
            FontSize="14" />
        <ComboBox
            Grid.Row="4"
            Grid.Column="1"
            Height="40"
            Margin="0,4"
            SelectedItem="{Binding Status}"
            FontSize="14">
            <ComboBoxItem Content="正常" Tag="0" />
            <ComboBoxItem Content="停用" Tag="1" />
        </ComboBox>

        <TextBlock
            Grid.Row="5"
            Grid.Column="0"
            Margin="0,8,0,0"
            VerticalAlignment="Center"
            Text="备注"
            FontSize="14" />
        <TextBox
            Grid.Row="5"
            Grid.Column="1"
            Height="60"
            Margin="0,4"
            Text="{Binding Remark}"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            FontSize="14"
            materialDesign:HintAssist.Hint="请输入备注信息" />

        <StackPanel
            Grid.Row="6"
            Grid.Column="1"
            Margin="0,16,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Margin="0,0,12,0"
                Padding="16,6"
                Command="{Binding AcceptCommand}"
                Content="确定"
                Foreground="#fff"
                Background="#1890ff"
                BorderBrush="#1890ff"
                Style="{StaticResource MaterialDesignRaisedLightButton}" />
            <Button
                Padding="16,6"
                Command="{Binding CancelCommand}"
                Content="取消"
                Style="{StaticResource MaterialDesignOutlinedDarkButton}" />
        </StackPanel>
    </Grid>
</UserControl>