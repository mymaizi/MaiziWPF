<UserControl
    x:Class="MaiziWPF.Modules.Sys.ProfileView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:maiziWPF="clr-namespace:MaiziWPF.Core;assembly=MaiziWPF.Core"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="600"
    d:DesignWidth="1200"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <maiziWPF:FirstCharConverter x:Key="FirstCharConverter" />

        <Style x:Key="TabButtonStyle" TargetType="RadioButton">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#606266" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border
                            x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#07bf96" />
                                <Setter Property="Foreground" Value="#ffffff" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#e0f7f2" />
                                <Setter Property="Foreground" Value="#07bf96" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" Value="#07bf96" />
                                <Setter Property="Foreground" Value="#ffffff" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InfoLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#606266" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="InfoValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#606266" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>

        <Style x:Key="FormInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#ffffff" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="BorderBrush" Value="#d9d9d9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#ffffff" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="BorderBrush" Value="#d9d9d9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GenderRadioStyle" TargetType="RadioButton">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#606266" />
            <Setter Property="Margin" Value="0,0,20,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal">
                            <Border
                                Width="14"
                                Height="14"
                                CornerRadius="7"
                                BorderBrush="#d9d9d9"
                                BorderThickness="1"
                                Background="#ffffff">
                                <Border
                                    x:Name="innerCircle"
                                    Width="6"
                                    Height="6"
                                    CornerRadius="3"
                                    Background="#07bf96"
                                    Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="innerCircle" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  左侧：个人信息  -->
        <Border
            Grid.Column="0"
            Background="#ffffff"
            BorderBrush="#e8e8e8"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  标题  -->
                <Border
                    Padding="20,16"
                    BorderBrush="#e8e8e8"
                    BorderThickness="0,0,0,1">
                    <TextBlock
                        FontSize="15"
                        FontWeight="Medium"
                        Foreground="#333333"
                        Text="个人信息" />
                </Border>

                <!--  信息列表  -->
                <StackPanel Grid.Row="1" Margin="20,24,20,20">
                    <!--  头像  -->
                    <Border
                        Width="80"
                        Height="80"
                        Margin="0,0,0,24"
                        HorizontalAlignment="Center"
                        CornerRadius="40"
                        Background="#07bf96">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="32"
                            FontWeight="Bold"
                            Foreground="#ffffff"
                            Text="{Binding CurrentUser.NickName, Converter={StaticResource FirstCharConverter}, FallbackValue='A'}" />
                    </Border>

                    <!--  分割线  -->
                    <Border Height="1" Margin="0,0,0,16" Background="#e8e8e8" />

                    <!--  用户名称  -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon
                                Width="16"
                                Height="16"
                                VerticalAlignment="Center"
                                Foreground="#999999"
                                Kind="Account" />
                            <TextBlock Margin="6,0,0,0" Style="{StaticResource InfoLabelStyle}" Text="用户名称" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="2"
                            Style="{StaticResource InfoValueStyle}"
                            Text="{Binding CurrentUser.UserName, FallbackValue='admin'}" />
                    </Grid>
                    <Border Height="1" Background="#e8e8e8" />

                    <!--  手机号码  -->
                    <Grid Margin="0,12,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon
                                Width="16"
                                Height="16"
                                VerticalAlignment="Center"
                                Foreground="#999999"
                                Kind="Cellphone" />
                            <TextBlock Margin="6,0,0,0" Style="{StaticResource InfoLabelStyle}" Text="手机号码" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="2"
                            Style="{StaticResource InfoValueStyle}"
                            Text="{Binding CurrentUser.PhoneNumber, FallbackValue='-'}" />
                    </Grid>
                    <Border Height="1" Background="#e8e8e8" />

                    <!--  用户邮箱  -->
                    <Grid Margin="0,12,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon
                                Width="16"
                                Height="16"
                                VerticalAlignment="Center"
                                Foreground="#999999"
                                Kind="Email" />
                            <TextBlock Margin="6,0,0,0" Style="{StaticResource InfoLabelStyle}" Text="用户邮箱" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="2"
                            Style="{StaticResource InfoValueStyle}"
                            Text="{Binding CurrentUser.Email, FallbackValue='-'}" />
                    </Grid>
                    <Border Height="1" Background="#e8e8e8" />

                    <!--  所属部门  -->
                    <Grid Margin="0,12,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon
                                Width="16"
                                Height="16"
                                VerticalAlignment="Center"
                                Foreground="#999999"
                                Kind="OfficeBuilding" />
                            <TextBlock Margin="6,0,0,0" Style="{StaticResource InfoLabelStyle}" Text="所属部门" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="2"
                            Style="{StaticResource InfoValueStyle}"
                            Text="{Binding CurrentUser.Dept.DeptName, FallbackValue='-'}" />
                    </Grid>
                    <Border Height="1" Background="#e8e8e8" />

                    <!--  所属角色  -->
                    <Grid Margin="0,12,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon
                                Width="16"
                                Height="16"
                                VerticalAlignment="Center"
                                Foreground="#999999"
                                Kind="ShieldAccount" />
                            <TextBlock Margin="6,0,0,0" Style="{StaticResource InfoLabelStyle}" Text="所属角色" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="2"
                            Style="{StaticResource InfoValueStyle}"
                            Text="{Binding RoleNames, FallbackValue='-'}" />
                    </Grid>
                    <Border Height="1" Background="#e8e8e8" />

                    <!--  创建日期  -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon
                                Width="16"
                                Height="16"
                                VerticalAlignment="Center"
                                Foreground="#999999"
                                Kind="Calendar" />
                            <TextBlock Margin="6,0,0,0" Style="{StaticResource InfoLabelStyle}" Text="创建日期" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="2"
                            Style="{StaticResource InfoValueStyle}"
                            Text="{Binding CurrentUser.CreateTime, StringFormat='yyyy-MM-dd', FallbackValue='-'}" />
                    </Grid>
                    <Border Height="1" Background="#e8e8e8" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  右侧：个人设置  -->
        <Border
            Grid.Column="2"
            Background="#ffffff"
            BorderBrush="#e8e8e8"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  标题区域  -->
                <Border
                    Grid.Row="0"
                    Padding="24,20,24,16"
                    BorderBrush="#e8e8e8"
                    BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock
                            FontSize="16"
                            FontWeight="Medium"
                            Foreground="#333333"
                            Text="个人设置" />
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="12"
                            Foreground="#999999"
                            Text="维护个人资料、密码。" />
                    </StackPanel>
                </Border>

                <!--  内容区域  -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  Tab 切换  -->
                    <Border
                        Grid.Row="0"
                        Padding="24,16,24,0"
                        BorderBrush="#e8e8e8"
                        BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton
                                Content="基本资料"
                                GroupName="ProfileTabs"
                                IsChecked="{Binding IsBasicInfoTab, Mode=TwoWay}"
                                Style="{StaticResource TabButtonStyle}" />
                            <RadioButton
                                Content="修改密码"
                                GroupName="ProfileTabs"
                                IsChecked="{Binding IsPasswordTab, Mode=TwoWay}"
                                Style="{StaticResource TabButtonStyle}" />
                        </StackPanel>
                    </Border>

                    <!--  基本资料 Tab  -->
                    <Border
                        Grid.Row="1"
                        Padding="24,24,24,24"
                        Visibility="{Binding IsBasicInfoTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--  用户昵称  -->
                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="280" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource FormLabelStyle}" Text="* 用户昵称" />
                                <TextBox
                                    Grid.Column="2"
                                    Style="{StaticResource FormInputStyle}"
                                    Text="{Binding NickName, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <!--  手机号码  -->
                            <Grid Grid.Row="1" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="280" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource FormLabelStyle}" Text="* 手机号码" />
                                <TextBox
                                    Grid.Column="2"
                                    Style="{StaticResource FormInputStyle}"
                                    Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <!--  邮箱  -->
                            <Grid Grid.Row="2" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="280" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource FormLabelStyle}" Text="* 邮箱" />
                                <TextBox
                                    Grid.Column="2"
                                    Style="{StaticResource FormInputStyle}"
                                    Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <!--  性别  -->
                            <Grid Grid.Row="3" Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource FormLabelStyle}" Text="性别" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton
                                        Content="男"
                                        IsChecked="{Binding IsMale, Mode=TwoWay}"
                                        Style="{StaticResource GenderRadioStyle}" />
                                    <RadioButton
                                        Content="女"
                                        IsChecked="{Binding IsFemale, Mode=TwoWay}"
                                        Style="{StaticResource GenderRadioStyle}" />
                                    <RadioButton
                                        Content="未知"
                                        IsChecked="{Binding IsUnknown, Mode=TwoWay}"
                                        Style="{StaticResource GenderRadioStyle}" />
                                </StackPanel>
                            </Grid>

                            <!--  按钮  -->
                            <StackPanel Grid.Row="4" Orientation="Horizontal">
                                <Button
                                    Width="80"
                                    Height="34"
                                    Margin="0,0,12,0"
                                    Background="#07bf96"
                                    BorderBrush="#07bf96"
                                    Command="{Binding SaveBasicInfoCommand}"
                                    Content="保存"
                                    Foreground="#ffffff"
                                    Style="{StaticResource MaterialDesignRaisedLightButton}" />
                                <Button
                                    Width="80"
                                    Height="34"
                                    BorderBrush="#d9d9d9"
                                    Command="{Binding CloseCommand}"
                                    Content="关闭"
                                    Foreground="#606266"
                                    Style="{StaticResource MaterialDesignOutlinedDarkButton}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  修改密码 Tab  -->
                    <Border
                        Grid.Row="1"
                        Padding="24,24,24,24"
                        Visibility="{Binding IsPasswordTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  旧密码  -->
                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="280" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource FormLabelStyle}" Text="* 旧密码" />
                                <PasswordBox
                                    x:Name="OldPasswordBox"
                                    Grid.Column="2"
                                    Style="{StaticResource PasswordBoxStyle}"
                                    PasswordChanged="OldPasswordBox_PasswordChanged" />
                            </Grid>

                            <!--  新密码  -->
                            <Grid Grid.Row="1" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="280" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource FormLabelStyle}" Text="* 新密码" />
                                <PasswordBox
                                    x:Name="NewPasswordBox"
                                    Grid.Column="2"
                                    Style="{StaticResource PasswordBoxStyle}"
                                    PasswordChanged="NewPasswordBox_PasswordChanged" />
                            </Grid>

                            <!--  确认密码  -->
                            <Grid Grid.Row="2" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="280" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource FormLabelStyle}" Text="* 确认密码" />
                                <PasswordBox
                                    x:Name="ConfirmPasswordBox"
                                    Grid.Column="2"
                                    Style="{StaticResource PasswordBoxStyle}"
                                    PasswordChanged="ConfirmPasswordBox_PasswordChanged" />
                            </Grid>

                            <!--  按钮  -->
                            <StackPanel Grid.Row="3" Orientation="Horizontal">
                                <Button
                                    Width="80"
                                    Height="34"
                                    Margin="0,0,12,0"
                                    Background="#07bf96"
                                    BorderBrush="#07bf96"
                                    Command="{Binding ChangePasswordCommand}"
                                    Content="保存"
                                    Foreground="#ffffff"
                                    Style="{StaticResource MaterialDesignRaisedLightButton}" />
                                <Button
                                    Width="80"
                                    Height="34"
                                    BorderBrush="#d9d9d9"
                                    Command="{Binding CloseCommand}"
                                    Content="关闭"
                                    Foreground="#606266"
                                    Style="{StaticResource MaterialDesignOutlinedDarkButton}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>