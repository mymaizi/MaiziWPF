<UserControl
    x:Class="MaiziWPF.Modules.Sys.ConfigFormView"
    x:Name="RootUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:maiziWPF="clr-namespace:MaiziWPF.Core;assembly=MaiziWPF.Core"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Width="520" Height="250">
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="Title" Value="{Binding DialogTitle}" />
        </Style>
    </prism:Dialog.WindowStyle>
    <UserControl.Resources>
        <maiziWPF:BooleanConverter x:Key="EqualToBooleanConverter" />
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#606266" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <Style x:Key="RadioStyle" TargetType="RadioButton">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#606266" />
            <Setter Property="Margin" Value="0,0,24,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="1" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,12,20,12">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Style="{StaticResource FormLabel}" Foreground="#ff4d4f" Text="* 参数名称" />
                <TextBox
                    Grid.Column="2"
                    Height="36"
                    FontSize="13"
                    Text="{Binding ConfigName, UpdateSourceTrigger=PropertyChanged}"
                    materialDesign:HintAssist.Hint="请输入参数名称" />

                <TextBlock Grid.Column="3" Style="{StaticResource FormLabel}" Foreground="#ff4d4f" Text="* 参数键名" />
                <TextBox
                    Grid.Column="5"
                    Height="36"
                    FontSize="13"
                    Text="{Binding ConfigKey, UpdateSourceTrigger=PropertyChanged}"
                    materialDesign:HintAssist.Hint="请输入参数键名" />
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Style="{StaticResource FormLabel}" Foreground="#ff4d4f" Text="* 参数键值" />
                <TextBox
                    Grid.Column="2"
                    Height="36"
                    FontSize="13"
                    Text="{Binding ConfigValue, UpdateSourceTrigger=PropertyChanged}"
                    materialDesign:HintAssist.Hint="请输入参数键值" />

                <TextBlock Grid.Column="3" Style="{StaticResource FormLabel}" Text="系统内置" />
                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton
                        Content="是"
                        GroupName="ConfigType"
                        IsChecked="{Binding ConfigType, Converter={StaticResource EqualToBooleanConverter}, ConverterParameter=Y}"
                        Style="{StaticResource RadioStyle}" />
                    <RadioButton
                        Content="否"
                        GroupName="ConfigType"
                        IsChecked="{Binding ConfigType, Converter={StaticResource EqualToBooleanConverter}, ConverterParameter=N}"
                        Style="{StaticResource RadioStyle}" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource FormLabel}" Text="备注" />
                <TextBox
                    Grid.Column="2"
                    Height="36"
                    FontSize="13"
                    Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}"
                    materialDesign:HintAssist.Hint="请输入备注" />
            </Grid>
        </StackPanel>

        <Border Grid.Row="1" Background="#f0f0f0" />

        <StackPanel
            Grid.Row="2"
            Margin="20,12,20,16"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Margin="0,0,12,0"
                Padding="24,8"
                Background="#07bf96"
                BorderBrush="#07bf96"
                Command="{Binding AcceptCommand}"
                Content="确定"
                Foreground="#fff"
                Style="{StaticResource MaterialDesignRaisedLightButton}" />
            <Button
                Padding="24,8"
                BorderBrush="#dcdfe6"
                Command="{Binding CancelCommand}"
                Content="取消"
                Foreground="#606266"
                Style="{StaticResource MaterialDesignOutlinedDarkButton}" />
        </StackPanel>
    </Grid>
</UserControl>