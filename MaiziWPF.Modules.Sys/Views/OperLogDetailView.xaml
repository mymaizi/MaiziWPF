<UserControl
    x:Class="MaiziWPF.Modules.Sys.OperLogDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:MaiziWPF.Core;assembly=MaiziWPF.Core"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True">

    <UserControl.Resources>
        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#606266" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Width="600" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource DetailLabel}" Text="系统模块：" />
        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding Title}" />

        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource DetailLabel}" Text="操作人员：" />
        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding OperName}" />

        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource DetailLabel}" Text="部门名称：" />
        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding DeptName}" />

        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource DetailLabel}" Text="请求方法：" />
        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding Method}" />

        <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource DetailLabel}" Text="请求方式：" />
        <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding RequestMethod}" />

        <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource DetailLabel}" Text="请求地址：" />
        <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding OperUrl}" />

        <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource DetailLabel}" Text="操作IP：" />
        <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding OperIp}" />

        <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource DetailLabel}" Text="操作地点：" />
        <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding OperLocation}" />

        <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource DetailLabel}" Text="操作状态：" />
        <TextBlock Grid.Row="8" Grid.Column="1">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource DetailValue}">
                    <Setter Property="Foreground" Value="#52c41a" />
                    <Setter Property="Text" Value="成功" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="1">
                            <Setter Property="Text" Value="失败" />
                            <Setter Property="Foreground" Value="#ff4d4f" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <TextBlock Grid.Row="9" Grid.Column="0" Style="{StaticResource DetailLabel}" Text="操作时间：" />
        <TextBlock Grid.Row="9" Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding OperTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />

        <TextBlock Grid.Row="10" Grid.Column="0" Style="{StaticResource DetailLabel}" Text="消耗时间：" />
        <TextBlock Grid.Row="10" Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding CostTime, StringFormat={}{0}毫秒}" />

        <TextBlock Grid.Row="11" Grid.Column="0" Style="{StaticResource DetailLabel}" Text="请求参数：" />
        <TextBox Grid.Row="11" Grid.Column="1" IsReadOnly="True" Text="{Binding OperParam}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="100" />

        <StackPanel Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Command="{Binding CancelCommand}" Content="关闭" Style="{StaticResource MaterialDesignOutlinedDarkButton}" />
        </StackPanel>
    </Grid>
</UserControl>