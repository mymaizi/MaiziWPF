<UserControl
    x:Class="MaiziWPF.Modules.Sys.NoticeDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    Width="700"
    Height="500"
    Background="Transparent"
    prism:ViewModelLocator.AutoWireViewModel="True">
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="WindowStyle" Value="None" />
            <Setter Property="AllowsTransparency" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ResizeMode" Value="NoResize" />
            <Setter Property="ShowInTaskbar" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Window">
                        <Border Background="Transparent">
                            <AdornerDecorator>
                                <ContentPresenter />
                            </AdornerDecorator>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </prism:Dialog.WindowStyle>

    <UserControl.Resources>
        <Style x:Key="NoticeTypeBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#f6ffed" />
            <Setter Property="BorderBrush" Value="#b7eb8f" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding NoticeType}" Value="1">
                    <Setter Property="Background" Value="#fff7e6" />
                    <Setter Property="BorderBrush" Value="#ffd591" />
                </DataTrigger>
                <DataTrigger Binding="{Binding NoticeType}" Value="2">
                    <Setter Property="Background" Value="#f6ffed" />
                    <Setter Property="BorderBrush" Value="#b7eb8f" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#e6f7ff" />
            <Setter Property="BorderBrush" Value="#91d5ff" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="0">
                    <Setter Property="Background" Value="#e6f7ff" />
                    <Setter Property="BorderBrush" Value="#91d5ff" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="1">
                    <Setter Property="Background" Value="#fff1f0" />
                    <Setter Property="BorderBrush" Value="#ffa39e" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="#ffffff" BorderBrush="#e8e8e8" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Margin="24,12,16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="公告详情" Foreground="#333333" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button
                    Grid.Column="1"
                    Width="32"
                    Height="32"
                    Padding="0"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Command="{Binding CancelCommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="border"
                                Width="32"
                                Height="32"
                                CornerRadius="16"
                                Background="Transparent">
                                <materialDesign:PackIcon
                                    x:Name="icon"
                                    Width="16"
                                    Height="16"
                                    Kind="Close"
                                    Foreground="#999999"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#fff1f0" />
                                    <Setter TargetName="icon" Property="Foreground" Value="#ff4d4f" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- 公告标题 -->
            <TextBlock Grid.Row="1"
                       Text="{Binding NoticeTitle}"
                       Foreground="#333333"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="24,8,24,16"
                       TextWrapping="Wrap" />

            <!-- 元信息 -->
            <Border Grid.Row="2" Padding="24,0,24,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="类型：" Foreground="#999999" FontSize="13" VerticalAlignment="Center" />
                    <Border Style="{StaticResource NoticeTypeBadgeStyle}" Margin="0,0,16,0">
                        <TextBlock FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#52c41a" />
                                    <Setter Property="Text" Value="公告" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NoticeType}" Value="1">
                                            <Setter Property="Text" Value="通知" />
                                            <Setter Property="Foreground" Value="#fa8c16" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding NoticeType}" Value="2">
                                            <Setter Property="Text" Value="公告" />
                                            <Setter Property="Foreground" Value="#52c41a" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <TextBlock Text="状态：" Foreground="#999999" FontSize="13" VerticalAlignment="Center" />
                    <Border Style="{StaticResource StatusBadgeStyle}" Margin="0,0,16,0">
                        <TextBlock FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#1890ff" />
                                    <Setter Property="Text" Value="正常" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="0">
                                            <Setter Property="Text" Value="正常" />
                                            <Setter Property="Foreground" Value="#1890ff" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="1">
                                            <Setter Property="Text" Value="关闭" />
                                            <Setter Property="Foreground" Value="#ff4d4f" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <TextBlock Text="创建者：" Foreground="#999999" FontSize="13" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CreateBy}" Foreground="#606266" FontSize="13" VerticalAlignment="Center" Margin="0,0,16,0" />

                    <TextBlock Text="创建时间：" Foreground="#999999" FontSize="13" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CreateTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Foreground="#606266" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- 分隔线 -->
            <Border Grid.Row="3" Background="#f0f0f0" />

            <!-- 公告内容 -->
            <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock Text="{Binding NoticeContent}"
                           Foreground="#606266"
                           FontSize="14"
                           LineHeight="24"
                           TextWrapping="Wrap"
                           Margin="24" />
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>