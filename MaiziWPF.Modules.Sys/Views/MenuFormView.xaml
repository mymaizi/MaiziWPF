<UserControl
    x:Class="MaiziWPF.Modules.Sys.MenuFormView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:domain="clr-namespace:MaiziWPF.Services.Domain;assembly=MaiziWPF.Services.Domain"
    xmlns:local="clr-namespace:MaiziWPF.Modules.Sys"
    xmlns:maiziWPF="clr-namespace:MaiziWPF.Core;assembly=MaiziWPF.Core"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Width="620" Height="580">
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="Title" Value="{Binding DialogTitle}" />
        </Style>
    </prism:Dialog.WindowStyle>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <maiziWPF:BooleanConverter x:Key="EqualToBooleanConverter" />
        <maiziWPF:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <maiziWPF:StringToPackIconKindConverter x:Key="StringToPackIconKindConverter" />
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#606266" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <Style x:Key="RadioStyle" TargetType="RadioButton">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#606266" />
            <Setter Property="Margin" Value="0,0,24,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="1" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" Margin="20,12,20,12" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource FormLabel}" Text="上级菜单" />
                    <ComboBox
                        Grid.Column="2"
                        Height="36"
                        FontSize="13"
                        ItemsSource="{Binding MenuTreeItems}"
                        SelectedValue="{Binding ParentId}"
                        SelectedValuePath="Id"
                        DisplayMemberPath="MenuName"
                        materialDesign:HintAssist.Hint="顶级菜单" />
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource FormLabel}" Text="菜单类型" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton
                            Content="目录"
                            GroupName="MenuType"
                            IsChecked="{Binding MenuType, Converter={StaticResource EqualToBooleanConverter}, ConverterParameter=M}"
                            Style="{StaticResource RadioStyle}" />
                        <RadioButton
                            Content="菜单"
                            GroupName="MenuType"
                            IsChecked="{Binding MenuType, Converter={StaticResource EqualToBooleanConverter}, ConverterParameter=C}"
                            Style="{StaticResource RadioStyle}" />
                        <RadioButton
                            Content="按钮"
                            GroupName="MenuType"
                            IsChecked="{Binding MenuType, Converter={StaticResource EqualToBooleanConverter}, ConverterParameter=F}"
                            Style="{StaticResource RadioStyle}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MenuType}" Value="M">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding MenuType}" Value="C">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource FormLabel}" Text="菜单图标" />
                    <Grid Grid.Column="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Grid.Column="0"
                            Width="36"
                            Height="36"
                            Margin="0,0,8,0"
                            Background="#f5f5f5"
                            BorderBrush="#dcdfe6"
                            BorderThickness="1"
                            Command="{Binding OpenIconPickerCommand}"
                            Cursor="Hand"
                            ToolTip="选择图标">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#e6f7ff" />
                                            <Setter Property="BorderBrush" Value="#91d5ff" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <materialDesign:PackIcon
                                Width="20"
                                Height="20"
                                Foreground="#606266"
                                Kind="{Binding Icon, Converter={StaticResource StringToPackIconKindConverter}}" />
                        </Button>
                        <TextBox
                            Grid.Column="1"
                            Height="36"
                            FontSize="13"
                            IsReadOnly="True"
                            Text="{Binding Icon}"
                            materialDesign:HintAssist.Hint="点击左侧按钮选择图标" />
                    </Grid>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource FormLabel}" Foreground="#ff4d4f" Text="* 菜单名称" />
                    <TextBox
                        Grid.Column="2"
                        Height="36"
                        FontSize="13"
                        Text="{Binding MenuName}"
                        materialDesign:HintAssist.Hint="请输入菜单名称" />
                    <TextBlock Grid.Column="3" Style="{StaticResource FormLabel}" Text="显示排序" />
                    <TextBox
                        Grid.Column="5"
                        Height="36"
                        Width="120"
                        HorizontalAlignment="Left"
                        FontSize="13"
                        Text="{Binding OrderNum}"
                        materialDesign:HintAssist.Hint="请输入排序号" />
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MenuType}" Value="M">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding MenuType}" Value="C">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource FormLabel}" Text="是否外链" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton
                            Content="是"
                            GroupName="IsFrame"
                            IsChecked="{Binding IsFrame}"
                            Style="{StaticResource RadioStyle}" />
                        <RadioButton
                            Content="否"
                            GroupName="IsFrame"
                            IsChecked="{Binding IsFrame, Converter={StaticResource InverseBooleanConverter}}"
                            Style="{StaticResource RadioStyle}" />
                    </StackPanel>
                    <TextBlock Grid.Column="3" Style="{StaticResource FormLabel}" Text="路由地址" />
                    <TextBox
                        Grid.Column="5"
                        Height="36"
                        FontSize="13"
                        Text="{Binding Path}"
                        materialDesign:HintAssist.Hint="请输入路由地址" />
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MenuType}" Value="C">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource FormLabel}" Text="组件路径" />
                    <TextBox
                        Grid.Column="2"
                        Height="36"
                        FontSize="13"
                        Text="{Binding Component}"
                        materialDesign:HintAssist.Hint="请输入组件路径" />
                    <TextBlock Grid.Column="3" Style="{StaticResource FormLabel}" Text="权限字符" />
                    <TextBox
                        Grid.Column="5"
                        Height="36"
                        FontSize="13"
                        Text="{Binding Perms}"
                        materialDesign:HintAssist.Hint="请输入权限标识" />
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MenuType}" Value="F">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource FormLabel}" Text="权限字符" />
                    <TextBox
                        Grid.Column="2"
                        Height="36"
                        FontSize="13"
                        Text="{Binding Perms}"
                        materialDesign:HintAssist.Hint="请输入权限标识" />
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MenuType}" Value="C">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource FormLabel}" Text="路由参数" />
                    <TextBox
                        Grid.Column="2"
                        Height="36"
                        FontSize="13"
                        Text="{Binding Query}"
                        materialDesign:HintAssist.Hint="请输入路由参数" />
                    <TextBlock Grid.Column="3" Style="{StaticResource FormLabel}" Text="是否缓存" />
                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton
                            Content="缓存"
                            GroupName="IsCache"
                            IsChecked="{Binding IsCache}"
                            Style="{StaticResource RadioStyle}" />
                        <RadioButton
                            Content="不缓存"
                            GroupName="IsCache"
                            IsChecked="{Binding IsCache, Converter={StaticResource InverseBooleanConverter}}"
                            Style="{StaticResource RadioStyle}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MenuType}" Value="M">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding MenuType}" Value="C">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource FormLabel}" Text="显示状态" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton
                            Content="显示"
                            GroupName="IsVisible"
                            IsChecked="{Binding IsVisible}"
                            Style="{StaticResource RadioStyle}" />
                        <RadioButton
                            Content="隐藏"
                            GroupName="IsVisible"
                            IsChecked="{Binding IsVisible, Converter={StaticResource InverseBooleanConverter}}"
                            Style="{StaticResource RadioStyle}" />
                    </StackPanel>
                    <TextBlock Grid.Column="3" Style="{StaticResource FormLabel}" Text="菜单状态" />
                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton
                            Content="正常"
                            GroupName="Status"
                            IsChecked="{Binding Status, Converter={StaticResource EqualToBooleanConverter}, ConverterParameter=N}"
                            Style="{StaticResource RadioStyle}" />
                        <RadioButton
                            Content="停用"
                            GroupName="Status"
                            IsChecked="{Binding Status, Converter={StaticResource EqualToBooleanConverter}, ConverterParameter=Y}"
                            Style="{StaticResource RadioStyle}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MenuType}" Value="F">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource FormLabel}" Text="菜单状态" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton
                            Content="正常"
                            GroupName="Status"
                            IsChecked="{Binding Status, Converter={StaticResource EqualToBooleanConverter}, ConverterParameter=0}"
                            Style="{StaticResource RadioStyle}" />
                        <RadioButton
                            Content="停用"
                            GroupName="Status"
                            IsChecked="{Binding Status, Converter={StaticResource EqualToBooleanConverter}, ConverterParameter=1}"
                            Style="{StaticResource RadioStyle}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource FormLabel}" Text="备注" />
                    <TextBox
                        Grid.Column="2"
                        Height="36"
                        FontSize="13"
                        Text="{Binding Remark}"
                        materialDesign:HintAssist.Hint="请输入备注" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3" Background="#f0f0f0" />

        <StackPanel
            Grid.Row="4"
            Margin="20,12,20,16"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Margin="0,0,12,0"
                Padding="24,8"
                Background="#1890ff"
                BorderBrush="#1890ff"
                Command="{Binding AcceptCommand}"
                Content="确定"
                Foreground="#fff"
                Style="{StaticResource MaterialDesignRaisedLightButton}" />
            <Button
                Padding="24,8"
                BorderBrush="#dcdfe6"
                Command="{Binding CancelCommand}"
                Content="取消"
                Foreground="#606266"
                Style="{StaticResource MaterialDesignOutlinedDarkButton}" />
        </StackPanel>

        <Popup
            AllowsTransparency="True"
            IsOpen="{Binding IsIconPickerOpen}"
            Placement="Center"
            PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}"
            StaysOpen="True">
            <Grid>
                <Border
                    Width="620"
                    Height="460"
                    Background="White"
                    BorderBrush="#e0e0e0"
                    BorderThickness="1"
                    CornerRadius="6"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" Opacity="0.2" ShadowDepth="3" />
                    </Border.Effect>
                    <local:IconPickerView Width="620" Height="460" SelectedIcon="{Binding Icon, Mode=TwoWay}" />
                </Border>
                <Button
                    Padding="8,4"
                    Background="#1890ff"
                    BorderBrush="#1890ff"
                    Command="{Binding CloseIconPickerCommand}"
                    Content="关闭"
                    Foreground="#fff"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,20"
                    Style="{StaticResource MaterialDesignRaisedLightButton}" />
            </Grid>
        </Popup>
    </Grid>
</UserControl>