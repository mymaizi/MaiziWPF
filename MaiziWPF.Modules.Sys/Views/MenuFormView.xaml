<UserControl
    x:Class="MaiziWPF.Modules.Sys.MenuFormView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:domain="clr-namespace:MaiziWPF.Services.Domain;assembly=MaiziWPF.Services.Domain"
    xmlns:maiziWPF="clr-namespace:MaiziWPF.Core;assembly=MaiziWPF.Core"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Width="550" Height="520">
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="SizeToContent" Value="WidthAndHeight" />
            <Setter Property="ResizeMode" Value="CanResizeWithGrip" />
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
        </Style>
    </prism:Dialog.WindowStyle>
    <UserControl.Resources>
        <maiziWPF:DateTimeConverter x:Key="DateTimeConverter" />
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            Margin="0,8,0,0"
            VerticalAlignment="Center"
            Text="上级菜单"
            FontSize="14" />
        <ComboBox
            Grid.Row="0"
            Grid.Column="1"
            Height="40"
            Margin="0,4"
            ItemsSource="{Binding MenuTreeItems}"
            SelectedValue="{Binding ParentId}"
            SelectedValuePath="Id"
            DisplayMemberPath="MenuName"
            FontSize="14"
            materialDesign:HintAssist.Hint="顶级菜单" />

        <TextBlock
            Grid.Row="1"
            Grid.Column="0"
            Margin="0,8,0,0"
            VerticalAlignment="Center"
            Text="菜单类型"
            FontSize="14" />
        <ComboBox
            Grid.Row="1"
            Grid.Column="1"
            Height="40"
            Margin="0,4"
            SelectedItem="{Binding MenuType}"
            FontSize="14">
            <ComboBoxItem Content="目录" Tag="M" />
            <ComboBoxItem Content="菜单" Tag="C" />
            <ComboBoxItem Content="按钮" Tag="F" />
        </ComboBox>

        <TextBlock
            Grid.Row="2"
            Grid.Column="0"
            Margin="0,8,0,0"
            VerticalAlignment="Center"
            Text="菜单名称"
            FontSize="14" />
        <TextBox
            Grid.Row="2"
            Grid.Column="1"
            Height="40"
            Margin="0,4"
            Text="{Binding MenuName}"
            FontSize="14"
            materialDesign:HintAssist.Hint="请输入菜单名称" />

        <TextBlock
            Grid.Row="3"
            Grid.Column="0"
            Margin="0,8,0,0"
            VerticalAlignment="Center"
            Text="显示排序"
            FontSize="14" />
        <TextBox
            Grid.Row="3"
            Grid.Column="1"
            Height="40"
            Margin="0,4"
            Text="{Binding OrderNum}"
            FontSize="14"
            materialDesign:HintAssist.Hint="请输入排序号" />

        <TextBlock
            Grid.Row="4"
            Grid.Column="0"
            Margin="0,8,0,0"
            VerticalAlignment="Center"
            Text="图标"
            FontSize="14" />
        <TextBox
            Grid.Row="4"
            Grid.Column="1"
            Height="40"
            Margin="0,4"
            Text="{Binding Icon}"
            FontSize="14"
            materialDesign:HintAssist.Hint="如: Home, Settings" />

        <TextBlock
            Grid.Row="5"
            Grid.Column="0"
            Margin="0,8,0,0"
            VerticalAlignment="Center"
            Text="视图路径"
            FontSize="14" />
        <TextBox
            Grid.Row="5"
            Grid.Column="1"
            Height="40"
            Margin="0,4"
            Text="{Binding Component}"
            FontSize="14"
            materialDesign:HintAssist.Hint="如: Views/UserListView" />

        <TextBlock
            Grid.Row="6"
            Grid.Column="0"
            Margin="0,8,0,0"
            VerticalAlignment="Center"
            Text="权限标识"
            FontSize="14" />
        <TextBox
            Grid.Row="6"
            Grid.Column="1"
            Height="40"
            Margin="0,4"
            Text="{Binding Perms}"
            FontSize="14"
            materialDesign:HintAssist.Hint="如: system:user:list" />

        <TextBlock
            Grid.Row="7"
            Grid.Column="0"
            Margin="0,8,0,0"
            VerticalAlignment="Center"
            Text="菜单状态"
            FontSize="14" />
        <ComboBox
            Grid.Row="7"
            Grid.Column="1"
            Height="40"
            Margin="0,4"
            SelectedItem="{Binding Status}"
            FontSize="14">
            <ComboBoxItem Content="正常" Tag="0" />
            <ComboBoxItem Content="停用" Tag="1" />
        </ComboBox>

        <StackPanel
            Grid.Row="8"
            Grid.Column="1"
            Margin="0,16,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Margin="0,0,12,0"
                Padding="16,6"
                Command="{Binding AcceptCommand}"
                Content="确定"
                Foreground="#fff"
                Background="#1890ff"
                BorderBrush="#1890ff"
                Style="{StaticResource MaterialDesignRaisedLightButton}" />
            <Button
                Padding="16,6"
                Command="{Binding CancelCommand}"
                Content="取消"
                Style="{StaticResource MaterialDesignOutlinedDarkButton}" />
        </StackPanel>
    </Grid>
</UserControl>