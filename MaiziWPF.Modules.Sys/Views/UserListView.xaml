<UserControl
    x:Class="MaiziWPF.Modules.Sys.UserListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:domain="clr-namespace:MaiziWPF.Services.Domain;assembly=MaiziWPF.Services.Domain"
    xmlns:maiziWPF="clr-namespace:MaiziWPF.Core;assembly=MaiziWPF.Core"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True">

    <Border Background="WhiteSmoke" CornerRadius="0 0 10 0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  左侧部门树  -->
            <maiziWPF:DeptTreePanelControl
                Grid.Column="0"
                Margin="12,12,0,12"
                SelectedDeptId="{Binding DeptId, Mode=TwoWay}" />

            <!--  右侧内容区域  -->
            <Grid Grid.Column="2" Margin="0,12,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  筛选条件  -->
                <Border Grid.Row="0" Margin="0,0,0,6" Background="#ffffff" CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  筛选条件标题栏  -->
                        <Grid Margin="16,12,16,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="筛选条件" Foreground="#333333" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ToggleButton x:Name="FilterToggle" Grid.Column="1" Width="24" Height="24" IsChecked="True">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Setter Property="Content">
                                            <Setter.Value>
                                                <materialDesign:PackIcon Kind="ChevronUp" Foreground="#595959" Width="16" Height="16" />
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0" Padding="0">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsChecked" Value="False">
                                                <Setter Property="Content">
                                                    <Setter.Value>
                                                        <materialDesign:PackIcon Kind="ChevronDown" Foreground="#595959" Width="16" Height="16" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                        </Grid>

                        <!--  筛选字段  -->
                        <Border x:Name="FilterPanel" Grid.Row="1" Padding="16,0,16,16">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=FilterToggle}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <WrapPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,16,0">
                                    <TextBlock Width="56" Text="用户名称" TextAlignment="Right" Foreground="#666666" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox Width="200" Height="36" Padding="8,6" FontSize="13" Text="{Binding UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,8,16,0">
                                    <TextBlock Width="56" Text="手机号码" TextAlignment="Right" Foreground="#666666" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox Width="200" Height="36" Padding="8,6" FontSize="13" Text="{Binding PhoneNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,8,16,0">
                                    <TextBlock Width="56" Text="状态" TextAlignment="Right" Foreground="#666666" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox
                                        Width="200"
                                        Height="36"
                                        Padding="8,6"
                                        FontSize="13"
                                        maiziWPF:DataDictAssist.Type="sys_normal_disable"
                                        SelectedValuePath="DictValue"
                                        SelectedValue="{Binding Status, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type domain:SysDictData}">
                                                <TextBlock Text="{Binding DictLabel}" FontSize="13" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,8,16,0">
                                    <TextBlock Width="56" Text="创建时间" TextAlignment="Right" Foreground="#666666" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <maiziWPF:DateRangeControl
                                        Width="280"
                                        EndDateTime="{Binding QueryPageInfo.EndDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        StartDateTime="{Binding QueryPageInfo.StartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button
                                        Margin="0,0,8,0"
                                        Padding="16,6"
                                        Background="#07bf96"
                                        BorderBrush="#07bf96"
                                        Command="{Binding SearchButtonCommand}"
                                        Content="搜索"
                                        Foreground="#fff"
                                        maiziWPF:PermsAssist.Perms="system:user:query"
                                        Style="{StaticResource MaterialDesignRaisedLightButton}" />
                                    <Button
                                        Padding="16,6"
                                        BorderBrush="#dcdfe6"
                                        Command="{Binding ResetButtonCommand}"
                                        Content="重置"
                                        Foreground="#606266"
                                        maiziWPF:PermsAssist.Perms="system:user:query"
                                        Style="{StaticResource MaterialDesignOutlinedDarkButton}" />
                                </StackPanel>
                            </WrapPanel>
                        </Border>
                    </Grid>
                </Border>

                <!--  用户列表标题栏  -->
                <Border Grid.Row="1" Margin="0,6,0,6" Background="#ffffff" CornerRadius="8">
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="用户列表" Foreground="#333333" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="用户是系统的重要实体，包含用户基本信息、部门归属、岗位及角色关联。" Foreground="#999999" FontSize="12" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button
                                Margin="0,0,8,0"
                                Padding="12,6"
                                Background="#07bf96"
                                BorderBrush="#07bf96"
                                Command="{Binding AddButtonCommand}"
                                CommandParameter="{Binding}"
                                Foreground="#fff"
                                maiziWPF:PermsAssist.Perms="system:user:add"
                                Style="{StaticResource MaterialDesignRaisedLightButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" Margin="0,0,4,0" />
                                    <TextBlock Text="新增" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <Button
                                Padding="12,6"
                                Background="#ff4d4f"
                                BorderBrush="#ff4d4f"
                                Command="{Binding BatchDeleteCommand}"
                                CommandParameter="{Binding SelectedItems, ElementName=UserDataGrid}"
                                Foreground="#fff"
                                maiziWPF:PermsAssist.Perms="system:user:remove"
                                Style="{StaticResource MaterialDesignRaisedLightButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Delete" Width="14" Height="14" Margin="0,0,4,0" />
                                    <TextBlock Text="删除" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  表格  -->
                <Border Grid.Row="2">
                    <DataGrid
                        x:Name="UserDataGrid"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        GridLinesVisibility="None"
                        SelectionMode="Extended"
                        ItemsSource="{Binding DataList}">
                        <DataGrid.Resources>
                            <!--  状态徽章样式  -->
                            <Style x:Key="StatusBadgeStyle" TargetType="Border">
                                <Setter Property="CornerRadius" Value="10" />
                                <Setter Property="Padding" Value="10,2" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="Background" Value="#f6ffed" />
                                <Setter Property="BorderBrush" Value="#b7eb8f" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="1">
                                        <Setter Property="Background" Value="#fff1f0" />
                                        <Setter Property="BorderBrush" Value="#ffa39e" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#fafafa" />
                                <Setter Property="Foreground" Value="#333333" />
                                <Setter Property="FontSize" Value="13" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Height" Value="40" />
                                <Setter Property="BorderBrush" Value="#e8e8e8" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="Padding" Value="16,0" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style BasedOn="{StaticResource MaterialDesignDataGridCell}" TargetType="DataGridCell">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="60" IsReadOnly="False">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <CheckBox x:Name="SelectAllCheckBox"
                                                  Click="SelectAllCheckBox_Click"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center"
                                                  PreviewMouseLeftButtonDown="RowCheckBox_PreviewMouseLeftButtonDown">
                                            <CheckBox.Style>
                                                <Style TargetType="CheckBox" BasedOn="{StaticResource MaterialDesignCheckBox}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}" Value="True">
                                                            <Setter Property="IsChecked" Value="True" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </CheckBox.Style>
                                        </CheckBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding UserName}"
                                Header="用户名称"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding NickName}"
                                Header="用户昵称"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Dept.DeptName}"
                                Header="部门"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding PhoneNumber}"
                                Header="手机号码"
                                IsReadOnly="True" />
                            <DataGridTemplateColumn Width="*" Header="状态">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StatusBadgeStyle}" HorizontalAlignment="Center">
                                            <TextBlock FontSize="11" HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#52c41a" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="0">
                                                                <Setter Property="Text" Value="正常" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="1">
                                                                <Setter Property="Text" Value="停用" />
                                                                <Setter Property="Foreground" Value="#ff4d4f" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding CreateTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                Header="创建时间"
                                IsReadOnly="True" />
                            <DataGridTemplateColumn Width="*" Header="操作">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                            <Button
                                                Width="26"
                                                Height="24"
                                                Margin="0,0,4,0"
                                                Background="#e6f7ff"
                                                BorderBrush="#91d5ff"
                                                BorderThickness="1"
                                                Command="{Binding DataContext.EditButtonCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}"
                                                maiziWPF:PermsAssist.Perms="system:user:edit"
                                                ToolTip="编辑">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="3">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <materialDesign:PackIcon Kind="Pencil" Foreground="#91d5ff" Width="14" Height="14" />
                                            </Button>
                                            <Button
                                                Width="26"
                                                Height="24"
                                                Margin="0,0,4,0"
                                                Background="#fff1f0"
                                                BorderBrush="#ffa39e"
                                                BorderThickness="1"
                                                Command="{Binding DataContext.DeleteButtonCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}"
                                                maiziWPF:PermsAssist.Perms="system:user:remove"
                                                ToolTip="删除">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="3">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <materialDesign:PackIcon Kind="Delete" Foreground="#ffa39e" Width="14" Height="14" />
                                            </Button>
                                            <Button
                                                Width="26"
                                                Height="24"
                                                Background="#f6ffed"
                                                BorderBrush="#b7eb8f"
                                                BorderThickness="1"
                                                Command="{Binding DataContext.ResetPwdButtonCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}"
                                                maiziWPF:PermsAssist.Perms="system:user:resetPwd"
                                                ToolTip="重置密码">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="3">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <materialDesign:PackIcon Kind="LockReset" Foreground="#52c41a" Width="14" Height="14" />
                                            </Button>
                                            <Button
                                                Width="26"
                                                Height="24"
                                                Background="#f0f5ff"
                                                BorderBrush="#adc6ff"
                                                BorderThickness="1"
                                                Command="{Binding DataContext.AuthRoleButtonCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}"
                                                maiziWPF:PermsAssist.Perms="system:user:assignRole"
                                                ToolTip="分配角色">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="3">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <materialDesign:PackIcon Kind="AccountKey" Foreground="#597ef7" Width="14" Height="14" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <maiziWPF:PageControl
                    Grid.Row="3"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Right"
                    Count="{Binding Count}"
                    IsBusy="{Binding IsBusy}"
                    NextCommand="{Binding NextButtonCommand}"
                    PageNumber="{Binding PageNumber}"
                    PageSize="{Binding PageSize}"
                    PageSizeChangedCommand="{Binding PageSizeChangedCommand}"
                    PrevCommand="{Binding PrevButtonCommand}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>