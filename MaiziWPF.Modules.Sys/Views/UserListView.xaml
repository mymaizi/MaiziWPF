<UserControl
    x:Class="MaiziWPF.Modules.Sys.UserListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:domain="clr-namespace:MaiziWPF.Services.Domain;assembly=MaiziWPF.Services.Domain"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:maiziWPF="clr-namespace:MaiziWPF.Core;assembly=MaiziWPF.Core"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <maiziWPF:DateTimeConverter x:Key="DateTimeConverter" />
        <maiziWPF:BooleanConverter x:Key="BooleanConverter" />
        <maiziWPF:ListToStringConverter x:Key="ListToStringConverter" />
        <maiziWPF:VisibilityConverter x:Key="VisibilityConverter" />
    </UserControl.Resources>
    <Border Background="WhiteSmoke" CornerRadius="0 0 10 0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!--  左边部门树  -->
            <Border BorderBrush="#eee" BorderThickness="0,0,1,0">
                <StackPanel Margin="10,10,6,6">
                    <materialDesign:Card Padding="8,4,8,4">
                        <DockPanel>
                            <Button Command="{Binding DeptQueryCommand}" Style="{StaticResource MaterialDesignToolButton}">
                                <materialDesign:PackIcon Kind="Search" Opacity=".56" />
                            </Button>
                            <TextBox
                                materialDesign:HintAssist.Hint="请输入部门名称"
                                materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                                materialDesign:TextFieldAssist.HasClearButton="True"
                                BorderThickness="0"
                                FontSize="16"
                                Text="{Binding QueryPageInfo.DeptName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                    </materialDesign:Card>
                    <materialDesign:TreeListView FontSize="14" ItemsSource="{Binding DeptItems}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <prism:InvokeCommandAction Command="{Binding DeptSelectionCommand}" CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=materialDesign:TreeListView}}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                        <materialDesign:TreeListView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type domain:SysDept}" ItemsSource="{Binding Childs}" />
                        </materialDesign:TreeListView.Resources>
                        <materialDesign:TreeListView.View>
                            <GridView>
                                <GridView.ColumnHeaderContainerStyle>
                                    <Style TargetType="GridViewColumnHeader">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Style>
                                </GridView.ColumnHeaderContainerStyle>
                                <GridView.Columns>
                                    <GridViewColumn Width="210">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DeptName}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView.Columns>
                            </GridView>
                        </materialDesign:TreeListView.View>
                    </materialDesign:TreeListView>
                </StackPanel>
            </Border>
            <!--  右边列表  -->
            <Grid Grid.Column="1" Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!--  条件  -->
                <WrapPanel>
                    <materialDesign:Card Width="200" Style="{StaticResource FormCardStyle}">
                        <TextBox
                            materialDesign:HintAssist.Hint="请输入用户名称"
                            materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                            materialDesign:TextFieldAssist.HasClearButton="True"
                            BorderThickness="0"
                            FontSize="16"
                            Text="{Binding QueryPageInfo.UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </materialDesign:Card>
                    <materialDesign:Card Width="200" Style="{StaticResource FormCardStyle}">
                        <TextBox
                            materialDesign:HintAssist.Hint="请输入手机号码"
                            materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                            materialDesign:TextFieldAssist.HasClearButton="True"
                            BorderThickness="0"
                            FontSize="16"
                            Text="{Binding QueryPageInfo.PhoneNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </materialDesign:Card>
                    <materialDesign:Card Width="200" Style="{StaticResource FormCardStyle}">
                        <ComboBox
                            maiziWPF:DataDictAssist.Type="sys_normal_disable"
                            materialDesign:HintAssist.Hint="用户状态"
                            materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                            materialDesign:TextFieldAssist.HasClearButton="True"
                            BorderThickness="0"
                            FontSize="16"
                            SelectedItem="{Binding QueryPageInfo.Status, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type domain:SysDictData}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DictLabel}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </materialDesign:Card>
                    <materialDesign:Card Width="280" Style="{StaticResource FormCardStyle}">
                        <maiziWPF:DateRangeControl EndDateTime="{Binding QueryPageInfo.StartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" StartDateTime="{Binding QueryPageInfo.EndDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </materialDesign:Card>
                    <StackPanel Margin="6,0,0,6" Orientation="Horizontal">
                        <Button
                            Margin="0,0,8,0"
                            Background="#1890ff"
                            BorderBrush="#1890ff"
                            Command="{Binding SearchButtonCommand}"
                            Content="搜索"
                            Foreground="#fff"
                            Style="{StaticResource MaterialDesignRaisedLightButton}" />
                        <Button
                            BorderBrush="#dcdfe6"
                            Content="重置"
                            Foreground="#606266"
                            Style="{StaticResource MaterialDesignOutlinedDarkButton}" />
                    </StackPanel>
                </WrapPanel>
                <!--  按钮  -->
                <StackPanel
                    Grid.Row="1"
                    Margin="6,0,0,6"
                    Orientation="Horizontal">
                    <Button
                        Background="#1890ff"
                        BorderBrush="#1890ff"
                        Command="{Binding NewOrEditButtonCommand}"
                        Content="新增"
                        Foreground="#fff"
                        Style="{StaticResource MaterialDesignRaisedLightButton}" />
                </StackPanel>
                <!--  列表  -->
                <DataGrid
                    Grid.Row="2"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    GridLinesVisibility="None"
                    ItemsSource="{Binding DataList}">
                    <DataGrid.CellStyle>
                        <Style BasedOn="{StaticResource MaterialDesignDataGridCell}" TargetType="DataGridCell">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="BorderThickness" Value="0" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Binding="{Binding UserId}"
                            Header="用户编号"
                            IsReadOnly="True" />
                        <DataGridTextColumn
                            Binding="{Binding UserName}"
                            Header="用户名称"
                            IsReadOnly="True" />
                        <DataGridTextColumn
                            Binding="{Binding NickName}"
                            Header="用户昵称"
                            IsReadOnly="True" />
                        <DataGridTemplateColumn Header="部门">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Label Content="{Binding Depts, Converter={StaticResource ListToStringConverter}, ConverterParameter='DeptName'}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn
                            Binding="{Binding PhoneNumber}"
                            Header="手机号码"
                            IsReadOnly="True" />
                        <DataGridTemplateColumn Header="状态">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ToggleButton IsChecked="{Binding Status, Converter={StaticResource BooleanConverter}, ConverterParameter='1'}" Style="{StaticResource MaterialDesignSwitchToggleButton}">
                                        <materialDesign:ToggleButtonAssist.SwitchTrackOnBackground>
                                            <SolidColorBrush Color="#cf3539" />
                                        </materialDesign:ToggleButtonAssist.SwitchTrackOnBackground>
                                    </ToggleButton>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn
                            Binding="{Binding CreateTime, Converter={StaticResource DateTimeConverter}}"
                            Header="创建时间"
                            IsReadOnly="True" />
                        <DataGridTemplateColumn Header="操作">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding UserName, Converter={StaticResource VisibilityConverter}, ConverterParameter='admin'}">
                                        <Button
                                            Padding="5"
                                            Command="{Binding DataContext.NewOrEditButtonCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Content="修改"
                                            Foreground="#1890ff"
                                            Style="{StaticResource MaterialDesignFlatLightButton}" />
                                        <Button
                                            Padding="5"
                                            Command="{Binding DataContext.DeleteButtonCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Content="删除"
                                            Foreground="#cf3539"
                                            Style="{StaticResource MaterialDesignFlatLightButton}" />
                                        <Menu materialDesign:MenuAssist.MenuItemsPresenterMargin="3" materialDesign:MenuAssist.TopLevelMenuItemHeight="30">
                                            <MenuItem Padding="5" Header="更多&gt;&gt;">
                                                <MenuItem Header="重置密码" />
                                                <MenuItem Header="分配角色" />
                                            </MenuItem>
                                        </Menu>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <!--  分页  -->
                <maiziWPF:PageControl
                    Grid.Row="3"
                    Margin="0,0,10,10"
                    HorizontalAlignment="Right"
                    Count="{Binding Count}"
                    IsBusy="{Binding IsBusy}"
                    NextCommand="{Binding NextButtonCommand}"
                    PageNumber="{Binding PageNumber}"
                    PageSize="{Binding PageSize}"
                    PageSizeChangedCommand="{Binding PageSizeChangedCommand}"
                    PrevCommand="{Binding PrevButtonCommand}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>