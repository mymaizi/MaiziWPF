<UserControl
    x:Class="MaiziWPF.Modules.Sys.RoleAuthUserView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Width="780" Height="560">
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="Title" Value="{Binding DialogTitle}" />
        </Style>
    </prism:Dialog.WindowStyle>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="740" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
            <RowDefinition Height="1" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="3" Padding="20,12" Background="#fafafa" BorderBrush="#e8e8e8" BorderThickness="0,0,0,1">
            <TextBlock FontSize="12" Foreground="#999">
                <Run Text="角色：" /><Run Text="{Binding RoleName}" FontWeight="SemiBold" Foreground="#333" />
            </TextBlock>
        </Border>

        <Grid Grid.Row="2" Grid.Column="1" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#ffffff" CornerRadius="8" BorderBrush="#e8e8e8" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Padding="12,10"
                        Background="#f6ffed"
                        BorderBrush="#b7eb8f"
                        BorderThickness="0,0,0,1">
                        <TextBlock>
                            <Run Text="已分配用户（" Foreground="#52c41a" FontSize="13" FontWeight="SemiBold" />
                            <Run Text="{Binding AllocatedList.Count, Mode=OneWay}" Foreground="#52c41a" FontSize="13" FontWeight="SemiBold" />
                            <Run Text="）" Foreground="#52c41a" FontSize="13" FontWeight="SemiBold" />
                        </TextBlock>
                    </Border>

                    <ListBox
                        Grid.Row="1"
                        ItemsSource="{Binding AllocatedList}"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling"
                        VirtualizingPanel.ScrollUnit="Pixel"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        BorderThickness="0"
                        Background="Transparent">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter
                                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Padding="10,12,10,0"
                                        BorderBrush="#f0f0f0"
                                        BorderThickness="0,0,0,1">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    FontSize="13"
                                                    Foreground="#333"
                                                    FontWeight="SemiBold"
                                                    TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding NickName}" />
                                                    <Run Text="  " />
                                                    <Run Text="{Binding UserName, StringFormat='({0})'}" FontSize="11" Foreground="#999" />
                                                </TextBlock>
                                                <Button
                                                    Grid.Column="1"
                                                    Height="28"
                                                    Padding="6,2"
                                                    VerticalAlignment="Center"
                                                    Background="#fff1f0"
                                                    BorderBrush="#ffa39e"
                                                    BorderThickness="1"
                                                    Command="{Binding DataContext.CancelUserCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding}"
                                                    Foreground="#ff4d4f"
                                                    FontSize="12">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="AccountRemove" Width="12" Height="12" Margin="0,0,3,0" />
                                                        <TextBlock Text="取消授权" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                            <TextBlock Margin="0,0,0,0" FontSize="11" Foreground="#999" Text="{Binding PhoneNumber}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Width="48" VerticalAlignment="Center" HorizontalAlignment="Center">
                <materialDesign:PackIcon Kind="ArrowRight" Width="24" Height="24" Foreground="#d9d9d9" />
            </StackPanel>

            <Border Grid.Column="2" Background="#ffffff" CornerRadius="8" BorderBrush="#e8e8e8" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Padding="12,10"
                        Background="#e6f7ff"
                        BorderBrush="#91d5ff"
                        BorderThickness="0,0,0,1">
                        <TextBlock>
                            <Run Text="未分配用户（" Foreground="#1890ff" FontSize="13" FontWeight="SemiBold" />
                            <Run Text="{Binding UnallocatedList.Count, Mode=OneWay}" Foreground="#1890ff" FontSize="13" FontWeight="SemiBold" />
                            <Run Text="）" Foreground="#1890ff" FontSize="13" FontWeight="SemiBold" />
                        </TextBlock>
                    </Border>

                    <Border Grid.Row="1" Padding="8" BorderBrush="#f0f0f0" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Grid.Column="0"
                                Height="30"
                                FontSize="12"
                                Text="{Binding SearchUserName, UpdateSourceTrigger=PropertyChanged}"
                                materialDesign:HintAssist.Hint="用户名称" />
                            <TextBox
                                Grid.Column="2"
                                Height="30"
                                FontSize="12"
                                Text="{Binding SearchPhone, UpdateSourceTrigger=PropertyChanged}"
                                materialDesign:HintAssist.Hint="手机号码" />
                            <Button
                                Grid.Column="4"
                                Padding="10,4"
                                Background="#1890ff"
                                BorderBrush="#1890ff"
                                Command="{Binding LoadDataCommand}"
                                Foreground="#fff"
                                FontSize="12"
                                Style="{StaticResource MaterialDesignRaisedLightButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Search" Width="12" Height="12" Margin="0,0,3,0" />
                                    <TextBlock Text="搜索" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <ListBox
                        Grid.Row="2"
                        ItemsSource="{Binding UnallocatedList}"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling"
                        VirtualizingPanel.ScrollUnit="Pixel"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        BorderThickness="0"
                        Background="Transparent">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter
                                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Padding="10,12,0,0"
                                        BorderBrush="#f0f0f0"
                                        BorderThickness="0,0,0,1">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox
                                                    Height="14"
                                                    Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,8,0"
                                                    IsChecked="{Binding IsSelected}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    FontSize="13"
                                                    Foreground="#333"
                                                    FontWeight="SemiBold"
                                                    TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding User.NickName}" />
                                                    <Run Text="  " />
                                                    <Run Text="{Binding User.UserName, StringFormat='({0})'}" FontSize="11" Foreground="#999" />
                                                </TextBlock>
                                            </Grid>
                                            <TextBlock Margin="20,0,0,0" FontSize="11" Foreground="#999" Text="{Binding User.PhoneNumber}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                    <Border Grid.Row="3" Padding="12,10" BorderBrush="#f0f0f0" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox
                                Grid.Column="0"
                                Content="全选/取消全选"
                                FontSize="12"
                                Foreground="#606266"
                                IsChecked="{Binding SelectAll}"
                                VerticalAlignment="Center" />
                            <Button
                                Grid.Column="1"
                                Padding="12,4"
                                Background="#52c41a"
                                BorderBrush="#52c41a"
                                Command="{Binding BatchAddCommand}"
                                Foreground="#fff"
                                FontSize="12"
                                Style="{StaticResource MaterialDesignRaisedLightButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AccountPlus" Width="12" Height="12" Margin="0,0,3,0" />
                                    <TextBlock Text="批量授权" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Grid.ColumnSpan="3" Background="#f0f0f0" />

        <StackPanel
            Grid.Row="4" Grid.ColumnSpan="3"
            Margin="20,12,20,16"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Padding="24,8"
                BorderBrush="#dcdfe6"
                Command="{Binding CancelCommand}"
                Content="关闭"
                Foreground="#606266"
                Style="{StaticResource MaterialDesignOutlinedDarkButton}" />
        </StackPanel>
    </Grid>
</UserControl>