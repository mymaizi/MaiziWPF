<UserControl
    x:Class="MaiziWPF.Modules.Sys.UserFormView"
    x:Name="RootUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:maiziWPF="clr-namespace:MaiziWPF.Core;assembly=MaiziWPF.Core"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Width="580" Height="380">
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="Title" Value="{Binding DialogTitle}" />
        </Style>
    </prism:Dialog.WindowStyle>
    <UserControl.Resources>
        <maiziWPF:BooleanConverter x:Key="EqualToBooleanConverter" />
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#606266" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <Style x:Key="RadioStyle" TargetType="RadioButton">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#606266" />
            <Setter Property="Margin" Value="0,0,24,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="1" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,12,20,12">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Style="{StaticResource FormLabel}" Foreground="#ff4d4f" Text="* 用户昵称" />
                <TextBox
                    Grid.Column="2"
                    Height="36"
                    FontSize="13"
                    Text="{Binding NickName, UpdateSourceTrigger=PropertyChanged}"
                    materialDesign:HintAssist.Hint="请输入用户昵称" />

                <TextBlock Grid.Column="3" Style="{StaticResource FormLabel}" Text="归属部门" />
                <maiziWPF:DeptTreeSelectControl
                    Grid.Column="5"
                    SelectedDeptId="{Binding DeptId, Mode=TwoWay}" />
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Style="{StaticResource FormLabel}" Text="手机号码" />
                <TextBox
                    Grid.Column="2"
                    Height="36"
                    FontSize="13"
                    Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                    materialDesign:HintAssist.Hint="请输入手机号码" />

                <TextBlock Grid.Column="3" Style="{StaticResource FormLabel}" Text="邮箱" />
                <TextBox
                    Grid.Column="5"
                    Height="36"
                    FontSize="13"
                    Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                    materialDesign:HintAssist.Hint="请输入邮箱" />
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Style="{StaticResource FormLabel}" Text="用户性别" />
                <ComboBox
                    Grid.Column="2"
                    Height="36"
                    FontSize="13"
                    VerticalAlignment="Center"
                    maiziWPF:DataDictAssist.Type="sys_user_gender"
                    DisplayMemberPath="DictLabel"
                    SelectedValue="{Binding Gender, UpdateSourceTrigger=PropertyChanged}"
                    SelectedValuePath="DictValue"
                    materialDesign:HintAssist.Hint="请选择用户性别" />

                <TextBlock Grid.Column="3" Style="{StaticResource FormLabel}" Text="状态" />
                <ComboBox
                    Grid.Column="5"
                    Height="36"
                    FontSize="13"
                    VerticalAlignment="Center"
                    maiziWPF:DataDictAssist.Type="sys_normal_disable"
                    DisplayMemberPath="DictLabel"
                    SelectedValue="{Binding Status, UpdateSourceTrigger=PropertyChanged}"
                    SelectedValuePath="DictValue"
                    materialDesign:HintAssist.Hint="请选择状态" />
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Style="{StaticResource FormLabel}" Text="岗位" />
                <maiziWPF:SearchableComboBox
                    Grid.Column="2"
                    ItemsSource="{Binding Posts}"
                    SelectedValue="{Binding SelectedPostId, Mode=TwoWay}"
                    LoadMoreCommand="{Binding LoadMorePostsCommand}"
                    Placeholder="请选择岗位" />

                <TextBlock Grid.Column="3" Style="{StaticResource FormLabel}" Foreground="#ff4d4f" Text="* 角色" />
                <maiziWPF:MultiSelectComboBox
                    Grid.Column="5"
                    ItemsSource="{Binding Roles}"
                    SelectedItems="{Binding SelectedRoles, Mode=TwoWay}"
                    LoadMoreCommand="{Binding LoadMoreRolesCommand}"
                    Placeholder="请选择角色" />
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Style="{StaticResource FormLabel}" Text="备注" />
                <TextBox
                    Grid.Column="2"
                    Height="60"
                    FontSize="13"
                    AcceptsReturn="True"
                    Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap"
                    materialDesign:HintAssist.Hint="请输入备注" />
            </Grid>
        </StackPanel>

        <Border Grid.Row="1" Background="#f0f0f0" />

        <StackPanel
            Grid.Row="2"
            Margin="20,12,20,16"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="80" Height="36"
                Margin="0,0,12,0"
                Background="#1890ff"
                BorderBrush="#1890ff"
                Command="{Binding AcceptCommand}"
                Content="确定"
                Foreground="#fff"
                Style="{StaticResource MaterialDesignRaisedLightButton}" />
            <Button
                Width="80" Height="36"
                BorderBrush="#dcdfe6"
                Command="{Binding CancelCommand}"
                Content="取消"
                Foreground="#606266"
                Style="{StaticResource MaterialDesignOutlinedDarkButton}" />
        </StackPanel>
    </Grid>
</UserControl>