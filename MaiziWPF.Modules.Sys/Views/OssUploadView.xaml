<UserControl
    x:Class="MaiziWPF.Modules.Sys.OssUploadView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Width="600" Height="450">
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="Title" Value="文件上传" />
        </Style>
    </prism:Dialog.WindowStyle>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Button
                Margin="0,0,8,0"
                Padding="12,6"
                Background="#07bf96"
                BorderBrush="#07bf96"
                Foreground="#fff"
                Command="{Binding SelectFilesCommand}"
                Style="{StaticResource MaterialDesignRaisedLightButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="FolderOpen" Width="14" Height="14" Margin="0,0,4,0" />
                    <TextBlock Text="选择文件" FontSize="12" />
                </StackPanel>
            </Button>
            <Button
                Padding="12,6"
                Background="#07bf96"
                BorderBrush="#07bf96"
                Foreground="#fff"
                Command="{Binding UploadCommand}"
                Style="{StaticResource MaterialDesignRaisedLightButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CloudUpload" Width="14" Height="14" Margin="0,0,4,0" />
                    <TextBlock Text="开始上传" FontSize="12" />
                </StackPanel>
            </Button>
        </StackPanel>

        <DataGrid Grid.Row="1"
            ItemsSource="{Binding UploadItems}"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            IsReadOnly="True"
            HeadersVisibility="Column"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled"
            Style="{StaticResource MaterialDesignDataGrid}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="*" />
                <DataGridTextColumn Header="大小" Binding="{Binding FileSizeDisplay}" Width="80" />
                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="150" />
                <DataGridTemplateColumn Header="进度" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" Height="6"
                                Visibility="{Binding ProgressVisibility}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button
                Padding="24,8"
                BorderBrush="#dcdfe6"
                Content="关闭"
                Command="{Binding CancelCommand}"
                Foreground="#606266"
                Style="{StaticResource MaterialDesignOutlinedDarkButton}" />
        </StackPanel>
    </Grid>
</UserControl>