<UserControl
    x:Class="MaiziWPF.Modules.Sys.DictListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:domain="clr-namespace:MaiziWPF.Services.Domain;assembly=MaiziWPF.Services.Domain"
    xmlns:maiziWPF="clr-namespace:MaiziWPF.Core;assembly=MaiziWPF.Core"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True">

    <UserControl.Resources>
        <maiziWPF:DateTimeConverter x:Key="DateTimeConverter" />
    </UserControl.Resources>

    <Border Background="WhiteSmoke" CornerRadius="0 0 10 0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  左侧：字典类型  -->
            <Border Grid.Column="0" Margin="12,12,0,12" Background="#ffffff" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  标题  -->
                    <Grid Margin="16,12,16,8">
                        <TextBlock Text="字典管理" Foreground="#333333" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Grid>

                    <!--  筛选条件  -->
                    <Border Grid.Row="1" Margin="16,0,16,8" Padding="12,8" Background="#fafafa" CornerRadius="6">
                        <WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                                <TextBlock Width="56" Text="字典名称" TextAlignment="Right" Foreground="#666666" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Width="140" Height="32" Padding="6,4" FontSize="12" Text="{Binding QueryPageInfo.DictName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                                <TextBlock Width="56" Text="字典类型" TextAlignment="Right" Foreground="#666666" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Width="140" Height="32" Padding="6,4" FontSize="12" Text="{Binding QueryPageInfo.DictType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <Button
                                Margin="0,0,6,0"
                                Padding="12,4"
                                Background="#07bf96"
                                BorderBrush="#07bf96"
                                Command="{Binding SearchButtonCommand}"
                                Content="搜索"
                                FontSize="12"
                                Foreground="#fff"
                                Style="{StaticResource MaterialDesignRaisedLightButton}" />
                            <Button
                                Padding="12,4"
                                BorderBrush="#dcdfe6"
                                Command="{Binding ResetButtonCommand}"
                                Content="重置"
                                FontSize="12"
                                Foreground="#606266"
                                Style="{StaticResource MaterialDesignOutlinedDarkButton}" />
                        </WrapPanel>
                    </Border>

                    <!--  工具栏  -->
                    <Border Grid.Row="2" Margin="16,0,16,8" Padding="0,0,0,8" BorderBrush="#f0f0f0" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button
                                Margin="0,0,6,0"
                                Padding="10,4"
                                Background="#07bf96"
                                BorderBrush="#07bf96"
                                Command="{Binding AddDictTypeCommand}"
                                Foreground="#fff"
                                Style="{StaticResource MaterialDesignRaisedLightButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" Width="12" Height="12" Margin="0,0,3,0" />
                                    <TextBlock Text="新增" FontSize="11" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!--  表格  -->
                    <DataGrid
                        Grid.Row="3"
                        Margin="16,0,16,0"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        GridLinesVisibility="None"
                        ItemsSource="{Binding DataList}"
                        SelectedItem="{Binding SelectedDictType, Mode=TwoWay}"
                        SelectionMode="Single">
                        <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#fafafa" />
                            <Setter Property="Foreground" Value="#333333" />
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Height" Value="40" />
                            <Setter Property="BorderBrush" Value="#e8e8e8" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="Padding" Value="16,0" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style BasedOn="{StaticResource MaterialDesignDataGridCell}" TargetType="DataGridCell">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="FontSize" Value="13" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="BorderThickness" Value="0" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Binding="{Binding DictName}"
                            Header="字典名称"
                            IsReadOnly="True"
                            Width="*" />
                        <DataGridTextColumn
                            Binding="{Binding DictType}"
                            Header="字典类型"
                            IsReadOnly="True"
                            Width="*" />
                        <DataGridTextColumn
                            Binding="{Binding Remark}"
                            Header="备注"
                            IsReadOnly="True"
                            Width="*" />
                        <DataGridTemplateColumn Header="操作" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button
                                            Width="26"
                                            Height="24"
                                            Margin="0,0,4,0"
                                            Background="#e6f7ff"
                                            BorderBrush="#91d5ff"
                                            BorderThickness="1"
                                            Command="{Binding DataContext.EditDictTypeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="修改">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="3">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <materialDesign:PackIcon Kind="Pencil" Foreground="#91d5ff" Width="14" Height="14" />
                                        </Button>
                                        <Button
                                            Width="26"
                                            Height="24"
                                            Background="#fff1f0"
                                            BorderBrush="#ffa39e"
                                            BorderThickness="1"
                                            Command="{Binding DataContext.DeleteDictTypeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="删除">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="3">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <materialDesign:PackIcon Kind="Delete" Foreground="#ffa39e" Width="14" Height="14" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!--  分页  -->
                <maiziWPF:PageControl
                    Grid.Row="4"
                    Margin="16,8,16,12"
                    HorizontalAlignment="Right"
                    Count="{Binding Count}"
                    NextCommand="{Binding NextButtonCommand}"
                    PageNumber="{Binding PageNumber}"
                    PageSize="{Binding PageSize}"
                    PrevCommand="{Binding PrevButtonCommand}" />
                </Grid>
            </Border>

            <!--  分隔条  -->
            <GridSplitter
                Grid.Column="1"
                Width="4"
                HorizontalAlignment="Stretch"
                Background="#e8e8e8" />

            <!--  右侧：字典数据  -->
            <Border Grid.Column="2" Margin="0,12,12,12" Background="#ffffff" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  标题  -->
                    <Grid Margin="16,12,16,8">
                        <StackPanel>
                            <TextBlock Text="字典数据" Foreground="#333333" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SelectedDictInfo}" Foreground="#999999" FontSize="11" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <!--  筛选条件  -->
                    <Border Grid.Row="1" Margin="16,0,16,8" Padding="12,8" Background="#fafafa" CornerRadius="6">
                        <WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                                <TextBlock Width="56" Text="字典标签" TextAlignment="Right" Foreground="#666666" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Width="140" Height="32" Padding="6,4" FontSize="12" Text="{Binding DictDataQuery.DictLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <Button
                                Margin="0,0,6,0"
                                Padding="12,4"
                                Background="#07bf96"
                                BorderBrush="#07bf96"
                                Command="{Binding SearchDictDataCommand}"
                                Content="搜索"
                                FontSize="12"
                                Foreground="#fff"
                                Style="{StaticResource MaterialDesignRaisedLightButton}" />
                            <Button
                                Padding="12,4"
                                BorderBrush="#dcdfe6"
                                Command="{Binding ResetDictDataCommand}"
                                Content="重置"
                                FontSize="12"
                                Foreground="#606266"
                                Style="{StaticResource MaterialDesignOutlinedDarkButton}" />
                        </WrapPanel>
                    </Border>

                    <!--  工具栏  -->
                    <Border Grid.Row="2" Margin="16,0,16,8" Padding="0,0,0,8" BorderBrush="#f0f0f0" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button
                                Margin="0,0,6,0"
                                Padding="10,4"
                                Background="#07bf96"
                                BorderBrush="#07bf96"
                                Command="{Binding AddDictDataCommand}"
                                Foreground="#fff"
                                Style="{StaticResource MaterialDesignRaisedLightButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" Width="12" Height="12" Margin="0,0,3,0" />
                                    <TextBlock Text="新增" FontSize="11" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!--  表格  -->
                    <DataGrid
                        Grid.Row="3"
                        Margin="16,0,16,0"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        GridLinesVisibility="None"
                        ItemsSource="{Binding DictDataList}"
                        SelectedItem="{Binding SelectedDictData, Mode=TwoWay}"
                        SelectionMode="Single">
                        <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#fafafa" />
                            <Setter Property="Foreground" Value="#333333" />
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Height" Value="40" />
                            <Setter Property="BorderBrush" Value="#e8e8e8" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="Padding" Value="16,0" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style BasedOn="{StaticResource MaterialDesignDataGridCell}" TargetType="DataGridCell">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="FontSize" Value="13" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="BorderThickness" Value="0" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Binding="{Binding DictLabel}"
                            Header="字典标签"
                            IsReadOnly="True"
                            Width="*" />
                        <DataGridTextColumn
                            Binding="{Binding DictValue}"
                            Header="字典键值"
                            IsReadOnly="True"
                            Width="*" />
                        <DataGridTextColumn
                            Binding="{Binding DictSort}"
                            Header="字典排序"
                            IsReadOnly="True"
                            Width="*" />
                        <DataGridTextColumn
                            Binding="{Binding Remark}"
                            Header="备注"
                            IsReadOnly="True"
                            Width="*" />
                        <DataGridTemplateColumn Header="操作" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button
                                            Width="26"
                                            Height="24"
                                            Margin="0,0,4,0"
                                            Background="#e6f7ff"
                                            BorderBrush="#91d5ff"
                                            BorderThickness="1"
                                            Command="{Binding DataContext.EditDictDataCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="修改">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="3">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <materialDesign:PackIcon Kind="Pencil" Foreground="#91d5ff" Width="14" Height="14" />
                                        </Button>
                                        <Button
                                            Width="26"
                                            Height="24"
                                            Background="#fff1f0"
                                            BorderBrush="#ffa39e"
                                            BorderThickness="1"
                                            Command="{Binding DataContext.DeleteDictDataCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="删除">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="3">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <materialDesign:PackIcon Kind="Delete" Foreground="#ffa39e" Width="14" Height="14" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!--  分页  -->
                <maiziWPF:PageControl
                    Grid.Row="4"
                    Margin="16,8,16,12"
                    HorizontalAlignment="Right"
                    Count="{Binding DictDataCount}"
                    NextCommand="{Binding DictDataNextCommand}"
                    PageNumber="{Binding DictDataPageNumber}"
                    PageSize="{Binding DictDataPageSize}"
                    PrevCommand="{Binding DictDataPrevCommand}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>