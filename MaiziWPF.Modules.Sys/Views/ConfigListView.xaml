<UserControl
    x:Class="MaiziWPF.Modules.Sys.ConfigListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:maiziWPF="clr-namespace:MaiziWPF.Core;assembly=MaiziWPF.Core"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True">

    <UserControl.Resources>
        <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="#05b790" />
        <SolidColorBrush x:Key="SecondaryAccentBrush" Color="#05b790" />
        <maiziWPF:DateTimeConverter x:Key="DateTimeConverter" />
        <maiziWPF:BooleanConverter x:Key="EqualToBooleanConverter" />
    </UserControl.Resources>

    <Border Background="WhiteSmoke" CornerRadius="0 0 10 0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  筛选条件  -->
            <Border Grid.Row="0" Margin="12,12,12,6" Background="#ffffff" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="16,12,16,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="筛选条件" Foreground="#333333" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ToggleButton x:Name="FilterToggle" Grid.Column="1" Width="24" Height="24" IsChecked="True">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <materialDesign:PackIcon Kind="ChevronUp" Foreground="#595959" Width="16" Height="16" />
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0" Padding="0">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="False">
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <materialDesign:PackIcon Kind="ChevronDown" Foreground="#595959" Width="16" Height="16" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                    </Grid>

                    <Border x:Name="FilterPanel" Grid.Row="1" Padding="16,0,16,16">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=FilterToggle}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,16,0">
                                <TextBlock Width="72" Text="参数名称" TextAlignment="Right" Foreground="#666666" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Width="200" Height="36" Padding="8,6" FontSize="13" Text="{Binding QueryPageInfo.ConfigName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,8,16,0">
                                <TextBlock Width="72" Text="参数键名" TextAlignment="Right" Foreground="#666666" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Width="200" Height="36" Padding="8,6" FontSize="13" Text="{Binding QueryPageInfo.ConfigKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Margin="0,0,8,0" Padding="16,6" Background="#1890ff" BorderBrush="#1890ff" Command="{Binding SearchButtonCommand}" Content="搜索" Foreground="#fff" Style="{StaticResource MaterialDesignRaisedLightButton}" />
                                <Button Padding="16,6" BorderBrush="#dcdfe6" Command="{Binding ResetButtonCommand}" Content="重置" Foreground="#606266" Style="{StaticResource MaterialDesignOutlinedDarkButton}" />
                            </StackPanel>
                        </WrapPanel>
                    </Border>
                </Grid>
            </Border>

            <!--  参数列表标题栏  -->
            <Border Grid.Row="1" Margin="12,6,12,6" Background="#ffffff" CornerRadius="8">
                <Grid Margin="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="参数列表" Foreground="#333333" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Count, StringFormat='共 {0} 条配置记录'}" Foreground="#999999" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>

                    <Button
                        Grid.Column="1"
                        Padding="12,6"
                        Background="#1890ff"
                        BorderBrush="#1890ff"
                        Command="{Binding AddConfigCommand}"
                        Foreground="#fff"
                        Style="{StaticResource MaterialDesignRaisedLightButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" Margin="0,0,4,0" />
                            <TextBlock Text="新增" FontSize="12" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!--  主内容区：左侧配置类型 + 右侧表格  -->
            <Grid Grid.Row="2" Margin="12,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  左侧：配置类型  -->
                <Border Grid.Column="0" Background="#ffffff" CornerRadius="8" Padding="12,16">
                    <StackPanel>
                        <TextBlock Text="配置类型" Foreground="#333333" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" />

                        <RadioButton
                            Content="全部"
                            GroupName="ConfigTypeFilter"
                            HorizontalContentAlignment="Right"
                            IsChecked="{Binding SelectedConfigTypeFilter, Converter={StaticResource EqualToBooleanConverter}, ConverterParameter=全部}"
                            Margin="4">
                            <RadioButton.Style>
                                <Style BasedOn="{StaticResource MaterialDesignTabRadioButtonRight}" TargetType="RadioButton">
                                    <Setter Property="Foreground" Value="#606266" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Foreground" Value="#05b790" />
                                            <Setter Property="BorderBrush" Value="#05b790" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </RadioButton.Style>
                        </RadioButton>

                        <RadioButton
                            Content="系统内置"
                            GroupName="ConfigTypeFilter"
                            HorizontalContentAlignment="Right"
                            IsChecked="{Binding SelectedConfigTypeFilter, Converter={StaticResource EqualToBooleanConverter}, ConverterParameter=系统内置}"
                            Margin="4">
                            <RadioButton.Style>
                                <Style BasedOn="{StaticResource MaterialDesignTabRadioButtonRight}" TargetType="RadioButton">
                                    <Setter Property="Foreground" Value="#606266" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Foreground" Value="#05b790" />
                                            <Setter Property="BorderBrush" Value="#05b790" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </RadioButton.Style>
                        </RadioButton>

                        <RadioButton
                            Content="自定义配置"
                            GroupName="ConfigTypeFilter"
                            HorizontalContentAlignment="Right"
                            IsChecked="{Binding SelectedConfigTypeFilter, Converter={StaticResource EqualToBooleanConverter}, ConverterParameter=自定义配置}"
                            Margin="4">
                            <RadioButton.Style>
                                <Style BasedOn="{StaticResource MaterialDesignTabRadioButtonRight}" TargetType="RadioButton">
                                    <Setter Property="Foreground" Value="#606266" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Foreground" Value="#05b790" />
                                            <Setter Property="BorderBrush" Value="#05b790" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </RadioButton.Style>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <!--  Divider  -->
                <GridSplitter
                    Grid.Column="1"
                    Width="4"
                    HorizontalAlignment="Stretch"
                    Background="#e8e8e8" />

                <!--  Right Content - Data Table  -->
                <Border Grid.Column="2" Background="#ffffff" CornerRadius="8" Padding="0">
                    <DataGrid
                        Margin="0"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        GridLinesVisibility="None"
                        ItemsSource="{Binding DataList}">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#fafafa" />
                                <Setter Property="Foreground" Value="#333333" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="FontSize" Value="13" />
                                <Setter Property="Height" Value="40" />
                                <Setter Property="Padding" Value="12,0" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="BorderBrush" Value="#e8e8e8" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style BasedOn="{StaticResource MaterialDesignDataGridCell}" TargetType="DataGridCell">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="FontSize" Value="13" />
                                <Setter Property="Padding" Value="12,8" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Binding="{Binding ConfigName}"
                                Header="参数名称"
                                IsReadOnly="True"
                                Width="200" />
                            <DataGridTextColumn
                                Binding="{Binding ConfigKey}"
                                Header="参数键名"
                                IsReadOnly="True"
                                Width="200" />
                            <DataGridTextColumn
                                Binding="{Binding ConfigValue}"
                                Header="参数键值"
                                IsReadOnly="True"
                                Width="*" />
                            <DataGridTemplateColumn Header="配置类型" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="13">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ConfigType}" Value="Y">
                                                            <Setter Property="Text" Value="系统内置" />
                                                            <Setter Property="Foreground" Value="#1890ff" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ConfigType}" Value="N">
                                                            <Setter Property="Text" Value="自定义" />
                                                            <Setter Property="Foreground" Value="#05b790" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                                Binding="{Binding Remark}"
                                Header="备注"
                                IsReadOnly="True"
                                Width="200" />
                            <DataGridTemplateColumn Header="操作" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                            <Button
                                                Width="26"
                                                Height="24"
                                                Margin="0,0,4,0"
                                                Background="#e6f7ff"
                                                BorderBrush="#91d5ff"
                                                BorderThickness="1"
                                                Command="{Binding DataContext.NewOrEditButtonCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="修改">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="3">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <materialDesign:PackIcon Kind="Pencil" Foreground="#91d5ff" Width="14" Height="14" />
                                            </Button>
                                            <Button
                                                Width="26"
                                                Height="24"
                                                Background="#fff1f0"
                                                BorderBrush="#ffa39e"
                                                BorderThickness="1"
                                                Command="{Binding DataContext.DeleteButtonCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="删除">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="3">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <materialDesign:PackIcon Kind="Delete" Foreground="#ffa39e" Width="14" Height="14" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!--  Pagination  -->
            <maiziWPF:PageControl
                Grid.Row="3"
                Margin="12,8,12,12"
                HorizontalAlignment="Right"
                Count="{Binding Count}"
                NextCommand="{Binding NextButtonCommand}"
                PageNumber="{Binding PageNumber}"
                PageSize="{Binding PageSize}"
                PrevCommand="{Binding PrevButtonCommand}" />
        </Grid>
    </Border>
</UserControl>