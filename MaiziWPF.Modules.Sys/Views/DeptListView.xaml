<UserControl
    x:Class="MaiziWPF.Modules.Sys.DeptListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:domain="clr-namespace:MaiziWPF.Services.Domain;assembly=MaiziWPF.Services.Domain"
    xmlns:maiziWPF="clr-namespace:MaiziWPF.Core;assembly=MaiziWPF.Core"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True">

    <Border Background="WhiteSmoke" CornerRadius="0 0 10 0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  筛选条件  -->
            <Border Grid.Row="0" Margin="12,12,12,6" Background="#ffffff" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  筛选条件标题栏  -->
                    <Grid Margin="16,12,16,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="筛选条件" Foreground="#333333" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ToggleButton x:Name="FilterToggle" Grid.Column="1" Width="24" Height="24" IsChecked="True">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <materialDesign:PackIcon Kind="ChevronUp" Foreground="#595959" Width="16" Height="16" />
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0" Padding="0">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="False">
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <materialDesign:PackIcon Kind="ChevronDown" Foreground="#595959" Width="16" Height="16" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                    </Grid>

                    <!--  筛选字段  -->
                    <Border x:Name="FilterPanel" Grid.Row="1" Padding="16,0,16,16">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=FilterToggle}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="部门名称" Foreground="#666666" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Column="1" Padding="8,6" FontSize="13" Text="{Binding DeptName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Column="2" Text="类别编码" Foreground="#666666" FontSize="13" VerticalAlignment="Center" Margin="16,0,8,0" />
                            <TextBox Grid.Column="3" Padding="8,6" FontSize="13" Text="{Binding DeptCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Column="4" Text="状态" Foreground="#666666" FontSize="13" VerticalAlignment="Center" Margin="16,0,8,0" />
                            <ComboBox
                                Grid.Column="5"
                                Padding="8,6"
                                FontSize="13"
                                maiziWPF:DataDictAssist.Type="sys_normal_disable"
                                SelectedValuePath="DictValue"
                                SelectedValue="{Binding Status, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type domain:SysDictData}">
                                        <TextBlock Text="{Binding DictLabel}" FontSize="13" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <StackPanel Grid.Column="7" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button
                                    Margin="0,0,8,0"
                                    Padding="16,6"
                                    Background="#07bf96"
                                    BorderBrush="#07bf96"
                                    Command="{Binding SearchButtonCommand}"
                                    Content="搜索"
                                    Foreground="#fff"
                                    maiziWPF:PermsAssist.Perms="system:dept:query"
                                    Style="{StaticResource MaterialDesignRaisedLightButton}" />
                                <Button
                                    Padding="16,6"
                                    BorderBrush="#dcdfe6"
                                    Command="{Binding ResetButtonCommand}"
                                    Content="重置"
                                    Foreground="#606266"
                                    maiziWPF:PermsAssist.Perms="system:dept:query"
                                    Style="{StaticResource MaterialDesignOutlinedDarkButton}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!--  部门列表标题栏  -->
            <Border Grid.Row="1" Margin="12,6,12,6" Background="#ffffff" CornerRadius="8">
                <Grid Margin="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="部门列表" Foreground="#333333" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="支持树形层级维护、负责人绑定和部门状态管理。" Foreground="#999999" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button
                            Margin="0,0,8,0"
                            Padding="12,6"
                            Background="#07bf96"
                            BorderBrush="#07bf96"
                            Command="{Binding AddButtonCommand}"
                            Foreground="#fff"
                            maiziWPF:PermsAssist.Perms="system:dept:add"
                            Style="{StaticResource MaterialDesignRaisedLightButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" Margin="0,0,4,0" />
                                <TextBlock Text="新增" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  树形表格  -->
            <Border Grid.Row="2" Margin="12,0,12,12" Background="#ffffff" CornerRadius="8">
                <materialDesign:TreeListView
                    maiziWPF:GridViewAssist.ColumnRatios="0.18,0.06,0.10,0.11,0.12,0.08,0.13,0.22"
                    Background="Transparent"
                    ItemsSource="{Binding DataList}">

                    <materialDesign:TreeListView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type domain:SysDept}" ItemsSource="{Binding Childs}" />

                        <!--  操作列图标按钮模板  -->
                        <ControlTemplate x:Key="IconButtonTemplate" TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>

                        <!--  状态徽章样式  -->
                        <Style x:Key="StatusBadgeStyle" TargetType="Border">
                            <Setter Property="CornerRadius" Value="10" />
                            <Setter Property="Padding" Value="10,2" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Background" Value="#f6ffed" />
                            <Setter Property="BorderBrush" Value="#b7eb8f" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="1">
                                    <Setter Property="Background" Value="#fff1f0" />
                                    <Setter Property="BorderBrush" Value="#ffa39e" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </materialDesign:TreeListView.Resources>

                    <materialDesign:TreeListView.View>
                        <GridView>
                            <GridView.ColumnHeaderContainerStyle>
                                <Style TargetType="GridViewColumnHeader">
                                    <Setter Property="Background" Value="#fafafa" />
                                    <Setter Property="Foreground" Value="#333333" />
                                    <Setter Property="FontSize" Value="13" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Height" Value="40" />
                                    <Setter Property="BorderBrush" Value="#e8e8e8" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    <Setter Property="Padding" Value="16,0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="GridViewColumnHeader">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalAlignment="Center"
                                                                      RecognizesAccessKey="True" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>

                            <GridView.Columns>
                                <!--  部门名称  -->
                                <GridViewColumn Header="部门名称">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DeptName}" Foreground="#333333" FontSize="13" Margin="16,0,0,0" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!--  排序  -->
                                <GridViewColumn Header="排序">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding OrderNum}" Foreground="#666666" FontSize="13" HorizontalAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!--  类别编码  -->
                                <GridViewColumn Header="类别编码">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DeptCategory}" Foreground="#666666" FontSize="13" Margin="8,0,0,0" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!--  负责人  -->
                                <GridViewColumn Header="负责人">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding LeaderName}" Foreground="#666666" FontSize="13" Margin="8,0,0,0" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!--  联系电话  -->
                                <GridViewColumn Header="联系电话">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Phone}" Foreground="#666666" FontSize="13" Margin="8,0,0,0" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!--  状态  -->
                                <GridViewColumn Header="状态">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource StatusBadgeStyle}" HorizontalAlignment="Center">
                                                <TextBlock FontSize="11" HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#52c41a" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="0">
                                                                    <Setter Property="Text" Value="正常" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="1">
                                                                    <Setter Property="Text" Value="停用" />
                                                                    <Setter Property="Foreground" Value="#ff4d4f" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!--  创建时间  -->
                                <GridViewColumn Header="创建时间">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CreateTime, StringFormat='yyyy-MM-dd HH:mm:ss'}" Foreground="#666666" FontSize="13" Margin="8,0,0,0" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!--  操作  -->
                                <GridViewColumn Header="操作">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                <Button
                                                    Width="26"
                                                    Height="24"
                                                    Margin="0,0,4,0"
                                                    Background="#e6f7ff"
                                                    BorderBrush="#91d5ff"
                                                    BorderThickness="1"
                                                    Command="{Binding DataContext.EditButtonCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding}"
                                                    maiziWPF:PermsAssist.Perms="system:dept:edit"
                                                    Template="{StaticResource IconButtonTemplate}"
                                                    ToolTip="编辑">
                                                    <materialDesign:PackIcon Kind="Pencil" Foreground="#91d5ff" Width="14" Height="14" />
                                                </Button>
                                                <Button
                                                    Width="26"
                                                    Height="24"
                                                    Margin="0,0,4,0"
                                                    Background="#f6ffed"
                                                    BorderBrush="#b7eb8f"
                                                    BorderThickness="1"
                                                    Command="{Binding DataContext.AddButtonCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding}"
                                                    maiziWPF:PermsAssist.Perms="system:dept:add"
                                                    Template="{StaticResource IconButtonTemplate}"
                                                    ToolTip="新增子部门">
                                                    <materialDesign:PackIcon Kind="PlusCircleOutline" Foreground="#b7eb8f" Width="14" Height="14" />
                                                </Button>
                                                <Button
                                                    Width="26"
                                                    Height="24"
                                                    Background="#fff1f0"
                                                    BorderBrush="#ffa39e"
                                                    BorderThickness="1"
                                                    Command="{Binding DataContext.DeleteButtonCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding}"
                                                    maiziWPF:PermsAssist.Perms="system:dept:remove"
                                                    Template="{StaticResource IconButtonTemplate}"
                                                    ToolTip="删除">
                                                    <materialDesign:PackIcon Kind="Delete" Foreground="#ffa39e" Width="14" Height="14" />
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView.Columns>
                        </GridView>
                    </materialDesign:TreeListView.View>
                </materialDesign:TreeListView>
            </Border>
        </Grid>
    </Border>
</UserControl>