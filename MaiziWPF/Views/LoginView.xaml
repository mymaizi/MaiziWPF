<UserControl
    x:Class="MaiziWPF.Views.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:maiziWPF="clr-namespace:MaiziWPF.Core;assembly=MaiziWPF.Core"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    Width="875"
    Height="545"
    prism:ViewModelLocator.AutoWireViewModel="True">
    <Grid Margin="20">
        <Grid.Effect>
            <DropShadowEffect
                BlurRadius="30"
                Opacity="0.4"
                ShadowDepth="1" />
        </Grid.Effect>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="1.22*" />
        </Grid.ColumnDefinitions>
        <Border
            Background="#07bf96"
            ClipToBounds="True"
            CornerRadius="10 0 0 10">
            <Border.Clip>
                <RectangleGeometry
                    RadiusX="10"
                    RadiusY="10"
                    Rect="0,0,400,505" />

            </Border.Clip>
            <Grid>
                <Ellipse
                    Width="500"
                    Height="500"
                    Margin="50,0,0,-200"
                    VerticalAlignment="Bottom"
                    Fill="#5eccb4"
                    Opacity="0.6" />
                <Ellipse
                    Width="300"
                    Height="300"
                    Margin="-450,0,0,30"
                    VerticalAlignment="Bottom"
                    Fill="#5bcbb3"
                    Opacity="0.3" />
                <Ellipse
                    Width="400"
                    Height="400"
                    Margin="-320,0,0,-120"
                    VerticalAlignment="Bottom"
                    Fill="#5eccb4"
                    Opacity="0.6" />
                <Ellipse
                    Width="250"
                    Height="250"
                    Margin="-380,0,0,-120"
                    VerticalAlignment="Bottom"
                    Fill="#5bc9b2" />
                <Ellipse
                    Width="400"
                    Height="400"
                    Margin="280,0,0,-70"
                    VerticalAlignment="Bottom"
                    Fill="#5bccb4" />
                <StackPanel Margin="0,120,0,0" VerticalAlignment="Top">
                    <TextBlock
                        FontSize="46"
                        FontWeight="Light"
                        Foreground="#ffffff"
                        Text="Login in"
                        TextAlignment="Center" />
                    <TextBlock
                        Margin="0,15,0,3"
                        FontSize="16"
                        FontWeight="Light"
                        Foreground="#d1f2ed"
                        Text="to use all features"
                        TextAlignment="Center" />
                    <TextBlock
                        FontSize="16"
                        FontWeight="Light"
                        Foreground="#ffffff"
                        Text="of the application"
                        TextAlignment="Center" />
                </StackPanel>
            </Grid>

        </Border>
        <Border
            Grid.Column="1"
            Background="#ffffff"
            CornerRadius="0 10 10 0">
            <Grid>
                <Button
                    Width="25"
                    Height="25"
                    Margin="0,8,8,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Command="{Binding CloseWindowCommand}"
                    Foreground="#05b790"
                    Style="{StaticResource MaterialDesignIconButton}">
                    <materialDesign:PackIcon Kind="Close" />
                </Button>

                <StackPanel Margin="75,0" VerticalAlignment="Center">
                    <TextBox
                        materialDesign:HintAssist.Hint="Username"
                        materialDesign:TextFieldAssist.HasClearButton="True"
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                        Text="{Binding UserName}" />
                    <PasswordBox
                        Margin="0,27"
                        materialDesign:HintAssist.Hint="Password"
                        materialDesign:PasswordBoxAssist.Password="{Binding Password, Mode=TwoWay}"
                        materialDesign:TextFieldAssist.HasClearButton="True"
                        Style="{StaticResource MaterialDesignFloatingHintRevealPasswordBox}" />
                    <Button
                        materialDesign:ButtonAssist.CornerRadius="6"
                        Background="#05b790"
                        Command="{Binding LoginCommand}"
                        Content="Login in"
                        FontSize="18"
                        Foreground="#ffffff"
                        Style="{StaticResource MaterialDesignFlatLightBgButton}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
