<UserControl
    x:Class="MaiziWPF.Core.DeptTreePanelControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Border Background="#ffffff" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                Margin="16,12,16,8"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="#333333"
                Text="{Binding HeaderText, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />

            <TextBox
                x:Name="PART_SearchBox"
                Grid.Row="0"
                Margin="12,40,12,8"
                Padding="8,6"
                FontSize="13"
                materialDesign:HintAssist.Hint="请输入部门名称"
                Text="{Binding SearchText, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Delay=300, UpdateSourceTrigger=PropertyChanged}" />

            <TreeView
                x:Name="PART_TreeView"
                Grid.Row="1"
                Margin="12,0,12,12"
                BorderThickness="0"
                ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                SelectedItemChanged="PART_TreeView_SelectedItemChanged">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Childs}">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="13"
                            Text="{Binding DeptName}" />
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Grid>
    </Border>
</UserControl>