<ToggleButton
    x:Class="MaiziWPF.Core.SearchableComboBox"
    x:Name="PART_ToggleButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Height="36"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Center"
    Padding="4,0"
    BorderBrush="#dcdfe6"
    Background="White"
    Cursor="Hand"
    TabIndex="0">
    <ToggleButton.Template>
        <ControlTemplate TargetType="ToggleButton">
            <Border
                x:Name="border"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        x:Name="PART_DisplayText"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="#c0c4cc"
                        Text="{Binding Placeholder, RelativeSource={RelativeSource TemplatedParent}}" />
                    <TextBlock
                        Grid.Column="0"
                        x:Name="PART_SelectedText"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="#303133"
                        Text="{Binding SelectedText, RelativeSource={RelativeSource TemplatedParent}}"
                        Visibility="Collapsed" />
                    <materialDesign:PackIcon
                        Grid.Column="1"
                        Width="16"
                        Height="16"
                        VerticalAlignment="Center"
                        Foreground="#909399"
                        Kind="ChevronDown" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="border" Property="BorderBrush" Value="#1890ff" />
                </Trigger>
                <DataTrigger Binding="{Binding HasSelection, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter TargetName="PART_DisplayText" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="PART_SelectedText" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </ToggleButton.Template>
    <Popup
        x:Name="PART_Popup"
        Width="{Binding ActualWidth, ElementName=PART_ToggleButton}"
        AllowsTransparency="True"
        IsOpen="{Binding IsChecked, ElementName=PART_ToggleButton}"
        Placement="Bottom"
        PlacementTarget="{Binding ElementName=PART_ToggleButton}"
        PopupAnimation="Fade"
        StaysOpen="False">
        <Border
            Background="White"
            BorderBrush="#e4e7ed"
            BorderThickness="1"
            CornerRadius="4"
            MaxHeight="280">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBox
                    x:Name="PART_SearchBox"
                    Margin="8,8"
                    Padding="8,4"
                    materialDesign:HintAssist.Hint="搜索..."
                    materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                    BorderThickness="0"
                    FontSize="13"
                    Text="{Binding SearchText, ElementName=PART_ToggleButton, UpdateSourceTrigger=PropertyChanged}" />
                <Border
                    Grid.Row="1"
                    Background="#e4e7ed" />
                <ListBox
                    x:Name="PART_ListBox"
                    Grid.Row="2"
                    BorderThickness="0"
                    ItemsSource="{Binding FilteredItems, ElementName=PART_ToggleButton}"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.ScrollUnit="Pixel"
                    VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <RadioButton
                                    Grid.Column="0"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                    Style="{StaticResource MaterialDesignRadioButton}" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="#303133"
                                    Text="{Binding Name}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="36" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#f5f7fa" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#ecf5ff" />
                                    <Setter Property="Foreground" Value="#1890ff" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>
    </Popup>
</ToggleButton>