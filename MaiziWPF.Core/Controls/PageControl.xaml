<UserControl
    x:Class="MaiziWPF.Core.PageControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MaiziWPF.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">

            <ProgressBar
                x:Name="LoadingBar"
                Width="16"
                Height="16"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                IsIndeterminate="True">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar" BasedOn="{StaticResource MaterialDesignCircularProgressBar}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy, RelativeSource={RelativeSource AncestorType={x:Type local:PageControl}}}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>

            <TextBlock
                x:Name="TotalText"
                VerticalAlignment="Center"
                FontSize="13"
                Foreground="#666666" />

            <Border
                Width="1"
                Margin="16,4"
                Background="#E8E8E8" />

            <TextBlock
                VerticalAlignment="Center"
                FontSize="13"
                Foreground="#666666"
                Text="每页" />

            <ComboBox
                x:Name="PageSizeCombo"
                Width="68"
                Margin="6,0"
                FontSize="13"
                SelectionChanged="PageSizeCombo_SelectionChanged" />

            <TextBlock
                VerticalAlignment="Center"
                FontSize="13"
                Foreground="#666666"
                Text="条" />

            <Border
                Width="1"
                Margin="16,4"
                Background="#E8E8E8" />

            <Button
                x:Name="PrevButton"
                Padding="10,5"
                VerticalAlignment="Center"
                BorderBrush="#D9D9D9"
                Command="{Binding PrevCommand, RelativeSource={RelativeSource AncestorType={x:Type local:PageControl}}}"
                Content="上一页"
                FontSize="13"
                Foreground="#595959"
                Style="{StaticResource MaterialDesignOutlinedDarkButton}" />

            <TextBlock
                x:Name="CurrentText"
                Margin="12,0"
                VerticalAlignment="Center"
                FontSize="13"
                Foreground="#333333" />

            <Button
                x:Name="NextButton"
                Padding="10,5"
                VerticalAlignment="Center"
                BorderBrush="#D9D9D9"
                Command="{Binding NextCommand, RelativeSource={RelativeSource AncestorType={x:Type local:PageControl}}}"
                Content="下一页"
                FontSize="13"
                Foreground="#595959"
                Style="{StaticResource MaterialDesignOutlinedDarkButton}" />

        </StackPanel>
    </Grid>
</UserControl>